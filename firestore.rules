rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================
    // 🔒 프로덕션용 보안 규칙
    // 학급 경제 교육 앱에 맞춤 설정
    // ========================================================

    // 헬퍼 함수들
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      // SuperAdmin은 관리자 권한을 모두 포함
      // exists() 선검사로 문서 없는 유저의 오류 방지
      //
      // 🔒 isApproved == true 필수 (2026-07-14 Gemini 교차검증):
      //    교사 회원가입은 공개돼 있고 가입자가 isAdmin:true를 스스로 넣을 수 있다(create 규칙은
      //    isApproved:false이기만 하면 허용). 그런데 승인 여부를 아무도 검사하지 않아서,
      //    누구나 교사로 가입 → classCode를 남의 학급으로 변경 → 그 학급의 완전한 관리자가 될 수 있었다
      //    (classCode 자기 변경은 '학급 참여' 정상 기능이라 막을 수 없다 → 승인 게이트로 막는다).
      //    실측(2026-07-14): 운영 중인 정상 교사 5명 전원 isApproved == true. 슈퍼관리자는 아래 OR로 예외.
      return isSignedIn() &&
             userDocExists() &&
             ((get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true &&
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isApproved', false) == true) ||
              isSuperAdmin());
    }

    function isSuperAdmin() {
      return isSignedIn() &&
             userDocExists() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isSuperAdmin', false) == true;
    }

    function getUserClassCode() {
      return userDocExists()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.classCode
        : '';
    }

    function isSameClass(classCode) {
      return isSignedIn() && getUserClassCode() == classCode;
    }

    // 🏫 학급 관리자 스코프 (2026-07-19 Phase1: "한 교사 = 한 학급" 확정):
    //   기존 `if isAdmin()` write 규칙은 학급경계를 전혀 검사하지 않아, 승인된 교사 A가
    //   클라 SDK로 타 학급(B)의 설정·카탈로그·학생 문서(cash 포함)를 직접 조작할 수 있었다
    //   (mint는 batch7에서 CF 이관으로 봉인됐으나 cross-class 정합성/그리핑 surface는 잔존).
    //   이제 학급소유(class-owned) 문서 write = '자기 학급' 교사만. 슈퍼관리자는 전 학급 유지.
    //   ⚠️ classCode를 경로/필드로 갖지 않는 '전역 공용' 컬렉션(CentralStocks·system_stats·settings·
    //      learningMaterials 등)에는 적용 불가 — 그건 계속 isAdmin()(공용 데이터, 학급 스코프 무의미).
    //   비용: isSameClass()의 get(users/self)는 isAdmin()이 이미 읽는 동일 경로라 요청 내 캐시될 수 있음(추가 과금 최소).
    function isClassAdmin(classCode) {
      return (isAdmin() && isSameClass(classCode)) || isSuperAdmin();
    }

    // 🏫 대상 학생과 같은 학급인가 — users/{userId} 서브컬렉션(loans·properties·financials 등)은
    //   classCode를 경로/자기 필드로 갖지 않으므로 '부모 user 문서'의 classCode를 get()해 비교한다.
    //   exists() 선검사로 문서 없는 대상(삭제됨) 참조 오류 방지(→ 슈퍼관리자만 통과).
    //   비용: get(users/대상) 1회 추가. 학생 본인 write는 호출부에서 isOwner로 단락되어 get 미발생.
    function isSameClassAsUser(userId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(userId)) &&
             getUserClassCode() == get(/databases/$(database)/documents/users/$(userId)).data.classCode;
    }
    function isClassAdminOfUser(userId) {
      return (isAdmin() && isSameClassAsUser(userId)) || isSuperAdmin();
    }

    // 🏦 국고(nationalTreasuries) 통계 필드 화이트리스트 (2026-07-19 보안 강화):
    //   국고 잔액=관리자 cash라 이 문서는 세수/수수료 '통계'만 담는다(totalAmount는 미사용 잔재).
    //   주식/부동산/경매/아이템 거래 시 클라가 revenue 필드를 increment하므로 같은 학급 write를
    //   완전 차단하지 못하지만, 임의 필드 주입은 막기 위해 이 목록으로 제한한다(hasOnly).
    // update 시 변경 허용되는 '가변 통계' 필드(생성시각 createdAt은 제외 = update 불변).
    //   create는 이 목록 + createdAt까지 허용(아래 create 규칙에서 concat).
    function treasuryStatKeys() {
      return ['totalAmount', 'stockTaxRevenue', 'stockCommissionRevenue',
              'realEstateTransactionTaxRevenue', 'vatRevenue', 'auctionTaxRevenue',
              'propertyHoldingTaxRevenue', 'netAssetTaxRevenue', 'itemMarketTaxRevenue',
              'incomeTaxRevenue', 'corporateTaxRevenue', 'otherTaxRevenue',
              'lastUpdated'];
    }

    // ========================================================
    // 🔥 읽기 전용 Fast 헬퍼 — Auth 커스텀 클레임 우선 단락평가로
    //    요청당 get(users/본인) 읽기 과금을 제거. 클레임 부재·불일치 시
    //    기존 문서 조회로 fallback하므로 동작 동일(fail-closed).
    //    클레임은 토큰 갱신(≤1h)까지 stale할 수 있으므로 "읽기" 규칙에만 쓰고,
    //    쓰기/생성/수정/삭제 규칙은 반드시 문서 기반 헬퍼(isSameClass/isAdmin/isSuperAdmin)를 유지한다.
    // ========================================================
    function isSameClassFast(classCode) {
      return isSignedIn() &&
             (('classCode' in request.auth.token && request.auth.token.classCode == classCode) ||
              getUserClassCode() == classCode);
    }

    // 🏫 settings/ 안의 '학급 소유' 문서 — docID 접미사가 곧 소유 학급이다.
    //   payload 의 self-report classCode 가 아니라 **docID** 를 자기 학급과 대조한다
    //   (payload 는 docID 와 decouple 돼 위조 가능 — 2026-07-19 Gemini v2 재현 사례).
    //   ⚠️ 여기 없는 새 접미사는 **거부**된다(fail-closed). settings/ 에 학급별 문서를
    //      새로 추가하면 이 목록에 등록할 것 — 조용히 통과시키는 것보다 낫다.
    // 🎯 goals 문서 ID(`{classCode}_goal`)가 자기 학급 것인가. 쓰기 규칙용이라 클레임이 아니라
    //   문서 기반(getUserClassCode)만 쓴다. 빈 학급코드 가드 포함(`'' + '_goal'` = `'_goal'` 차단).
    // 💓 Settings/activeStatus 하트비트 — 학생도 써야 하지만 **값까지** 고정한다.
    //   두 검증자의 지적이 정면으로 충돌한 지점이라 둘 다 만족시키는 형태로 짰다:
    //     · Gemini: 전체 키에 hasOnly() 를 걸면 이 문서에 레거시 필드가 하나만 생겨도
    //       하트비트가 **조용히** 막힌다(클라가 .catch(()=>{}) 로 삼킨다).
    //     · codex : hasOnly() 는 "이 키들만"이지 "이 키들이 있어야"가 아니라서,
    //       학생이 문서를 **빈 문서로 덮어** 주식 스케줄러를 멈출 수 있다.
    //   → 답은 "무엇이 바뀌었나"(affectedKeys)와 "값이 정당한가"(아래)를 **분리**하는 것이다.
    //     이 함수는 값만 본다. 키 제한은 create/update 각자의 규칙이 건다.
    function isValidHeartbeat(documentId) {
      return isSignedIn() && documentId == 'activeStatus' &&
             request.resource.data.keys().hasAll(['lastActiveAt', 'lastActiveUserId']) &&
             request.resource.data.lastActiveUserId == request.auth.uid &&
             request.resource.data.lastActiveAt is timestamp &&
             request.resource.data.lastActiveAt <= request.time;
    }

    function isOwnClassGoal(goalId) {
      return isSuperAdmin() ||
             (getUserClassCode() is string &&
              getUserClassCode().size() > 0 &&
              goalId == getUserClassCode() + '_goal');
    }

    // 읽기용 Fast 변형 — 클레임이 있으면 문서 조회 없이 판정(요청당 get 과금 회피).
    //   클레임이 없거나 안 맞으면 문서 기반으로 fallback(동작 동일·fail-closed).
    function isOwnClassSettingDocFast(documentId) {
      return (request.auth.token.get('classCode', '') is string &&
              request.auth.token.get('classCode', '').size() > 0 &&
              (documentId == 'salarySettings_' + request.auth.token.classCode ||
               documentId == 'menuLocks_' + request.auth.token.classCode)) ||
             isOwnClassSettingDoc(documentId);
    }

    function isOwnClassSettingDoc(documentId) {
      // 빈 학급코드 가드 — 없으면 `'salarySettings_' + ''` = `'salarySettings_'` 같은
      // "접미사 없는 껍데기 문서"를 학급 없는 계정이 쓸 수 있다(goals 와 같은 계열의 함정).
      return getUserClassCode() is string &&
             getUserClassCode().size() > 0 &&
             (documentId == 'salarySettings_' + getUserClassCode() ||
              documentId == 'menuLocks_' + getUserClassCode());
    }

    function isAdminFast() {
      // 클레임 경로도 승인(isApproved) 검사 — 미승인 계정이 클레임만으로 통과하지 못하게 한다.
      // 클레임에 isApproved가 없으면(구 토큰) 이 분기는 false가 되고 아래 isAdmin() 문서조회로 fallback.
      return isSignedIn() &&
             (('isAdmin' in request.auth.token && request.auth.token.isAdmin == true &&
               'isApproved' in request.auth.token && request.auth.token.isApproved == true) ||
              ('isSuperAdmin' in request.auth.token && request.auth.token.isSuperAdmin == true) ||
              isAdmin());
    }

    function isSuperAdminFast() {
      return isSignedIn() &&
             (('isSuperAdmin' in request.auth.token && request.auth.token.isSuperAdmin == true) ||
              isSuperAdmin());
    }

    // 🚨 경찰서 신고의 '당사자 신원' 필드는 생성 후 불변.
    //    합의금이 이 필드(피해자=victimId, 가해자=defendantId)를 기준으로 서버에서 지급되므로,
    //    같은 반 학생이 지급 직전에 update로 피해자를 바꿔치기해 합의금을 가로채는 것을 막는다.
    //    (접수·벌금 처리는 status·amount 등만 바꾸므로 이 동결에 영향받지 않는다.
    //     합의금 지급 CF는 Admin SDK라 규칙을 우회해 필요한 필드를 갱신할 수 있다.)
    function policeReportIdentityFrozen() {
      return request.resource.data.get('reporterId', '') == resource.data.get('reporterId', '') &&
             request.resource.data.get('complainantId', '') == resource.data.get('complainantId', '') &&
             request.resource.data.get('defendantId', '') == resource.data.get('defendantId', '') &&
             request.resource.data.get('reportedUserId', '') == resource.data.get('reportedUserId', '') &&
             request.resource.data.get('victimId', '') == resource.data.get('victimId', '');
    }

    // 🚨 신고 '생성' 시 신원 검증 — update 동결만으로는 부족하다. 검증 없는 create를 열어두면
    //    학생이 victimId=자기, defendantId=타겟(또는 빈값)인 위조 신고를 새로 만들어 합의금을
    //    자기에게 유도할 수 있다(codex 2026-07-15). 그래서 생성 자체를 다음으로 제약한다:
    //     · 신고자는 반드시 본인(reporterId==uid), 고소인도 본인
    //     · 합의금 수령 대상(victimId)에 자기 자신을 지정 금지 — 자기지급 원천 차단
    //     · 가해자(defendantId)는 존재하는 문자열이고 본인이 아님(→ 서버 senderId 파생이 항상 유효)
    function policeReportCreateValid() {
      return request.resource.data.get('reporterId', '') == request.auth.uid &&
             request.resource.data.get('complainantId', request.auth.uid) == request.auth.uid &&
             request.resource.data.get('defendantId', '') is string &&
             request.resource.data.get('defendantId', '') != '' &&
             request.resource.data.get('defendantId', '') != request.auth.uid &&
             request.resource.data.get('victimId', '') != request.auth.uid;
    }

    // 문자열 길이 검증 헬퍼
    function isValidString(value, maxLen) {
      return value is string && value.size() <= maxLen;
    }

    function isValidNumber(value, min, max) {
      return value is number && value >= min && value <= max;
    }

    // 데이터 유효성 검증
    function isValidUserData() {
      // 🔒 batch7-a-fix (2026-07-18 codex CRITICAL): 본인(학생) 신규 생성 시 cash·coupons는 반드시 0.
      //    구 `>= 0`은 상한이 없어, 학생이 '자기 문서 delete → cash:10억으로 재생성'으로 update-잠금(batch7-a)을
      //    통째로 우회해 무한 민팅할 수 있었다(allow delete: isOwner). 회원가입은 항상 cash:0·coupons:0이므로
      //    (Login.js:626) 정상 가입엔 영향 없고, 관리자 생성은 위 isAdmin() 분기라 이 검증을 안 탄다.
      //    ⚠️ classCode 값 자체는 create-time에 이전 값과 대조 불가(문서가 삭제됨) → cash:0 재생성으로 다른
      //       학급 이동(자기 자산 전소)은 잔존. 완전봉인 = 본인 user 문서 self-delete 차단 + deleteAccount CF(후속).
      return request.resource.data.keys().hasAll(['name', 'classCode', 'cash', 'coupons']) &&
             request.resource.data.cash == 0 &&
             request.resource.data.coupons == 0;
    }

    // ========================================================
    // 📁 users 컬렉션
    // ========================================================
    match /users/{userId} {
      // 읽기: 본인, 같은 학급, 관리자, 또는 SuperAdmin (전체 목록 조회용)
      allow read: if isOwner(userId) || isSameClassFast(resource.data.classCode) || isAdminFast() || isSuperAdminFast();

      // 생성: 본인만 (회원가입)
      // - isSuperAdmin은 절대 자체 설정 불가
      // - isAdmin/isTeacher로 가입할 경우 반드시 isApproved:false 강제 (셀프 승인 차단)
      //   슈퍼관리자가 별도로 isApproved:true로 승격해야 활성화됨
      //
      // 🔒 create 경로도 권한 필드를 막는다 (2026-07-14 codex 교차검증):
      //    update만 막으면 학생이 '자기 문서 delete → 권한 필드를 넣어 재생성'으로 우회할 수 있었다
      //    (allow delete: isOwner). 가입 시 직업·위임권한은 항상 비어 있어야 정상이므로,
      //    이 필드들이 아예 없거나 빈 값일 때만 생성을 허용한다.
      // 🔒 Phase1(2026-07-19 codex CRITICAL): create의 관리자 예외를 isAdmin()→isSuperAdmin()으로 축소.
      //    기존 isAdmin() 예외는 필드 제한이 전혀 없어, 승인 교사가 자신이 통제하는 새 Auth UID에
      //    setDoc(users/{새UID}, {isSuperAdmin:true, isApproved:true})를 생성 → 그 계정으로 로그인 =
      //    전 학급 슈퍼관리자 권한상승이 가능했다(update-escalation은 e8376b2에서 봉인했으나 create는 잔존).
      //    실측(2026-07-19): 클라의 정상 user 문서 생성은 전부 '본인 문서'(AuthContext 재생성·교사 가입 =
      //    아래 isOwner 분기)이고, 학생 계정 생성은 createStudentAccounts CF(Admin SDK, rules 우회)뿐 →
      //    교사가 '타 UID' 문서를 만드는 정상 클라 경로는 없다. 슈퍼관리자만 예외로 유지(회귀 0).
      allow create: if isSuperAdmin() ||
                      (isOwner(userId) && isValidUserData() &&
                       !request.resource.data.get('isSuperAdmin', false) &&
                       (
                         (
                           !request.resource.data.get('isAdmin', false) &&
                           !request.resource.data.get('isTeacher', false)
                         )
                         ||
                         request.resource.data.isApproved == false
                       ) &&
                       request.resource.data.get('selectedJobIds', []).size() == 0 &&
                       request.resource.data.get('appointedJobIds', []).size() == 0 &&
                       // 🔒 일일 할일 카운터도 create 시 반드시 비어 있어야 함(2026-07-19 codex CRITICAL):
                       //    update만 잠그면 '자기 문서 delete→재생성' 또는 가입 시 completedTasks에 음수
                       //    (예: -9e15)를 주입 → submitTaskApproval의 currentClicks>=maxClicks가 음수라
                       //    통과 → maxClicks 무력화 → pending 무제한(공모 mint). create도 빈 맵만 허용.
                       request.resource.data.get('completedTasks', {}).size() == 0 &&
                       request.resource.data.get('completedJobTasks', {}).size() == 0 &&
                       // 🔒 2026-08-21 (AAP P1-2): 학습앱 보상 카운터는 create 에서 **부재**여야 한다.
                       //    update 만 막으면 가입 시 `appRewardDaily: {day:'오늘', cash:-9e15}` 를
                       //    심어 하루 한도를 사실상 무한으로 늘릴 수 있다(음수는 남은 한도를 키운다).
                       //    서버는 이 값을 캡 판정에 쓴다 — 정상 가입 경로는 이 필드를 만들지 않는다.
                       !('appRewardDaily' in request.resource.data) &&
                       !('delegatedPermissions' in request.resource.data) &&
                       !('jobName' in request.resource.data) &&
                       !('jobTitle' in request.resource.data) &&
                       (!('nickname' in request.resource.data) || isValidString(request.resource.data.nickname, 20)) &&
                       // 🔒 2026-08-21 (P1-2 설계검증 중 codex CRITICAL, 재현 확인):
                       //    **자기 문서를 만들 때 학급을 스스로 주장할 수 없다.**
                       //    종전 create 규칙은 classCode 를 전혀 안 봤다. Firebase Auth 이메일 가입은
                       //    누구에게나 열려 있고(교사 등록 폼), 앱의 Firebase 설정은 배포 번들에서
                       //    누구나 읽는다 → 계정을 만들고 users/{내UID} 에 classCode:"BG6QUC" 를 써 넣으면
                       //    **그 학급의 학생으로 취급된다**: 주급 지급 대상(studentScope.isStudentDoc 은
                       //    classCode 유무 + 교사/슈퍼관리자 아님만 본다)이 되고, 학급 스코프 읽기로
                       //    반 아이들 이름까지 읽힌다. 초등학생 데이터다.
                       //    실측(2026-08-21): 클라가 user 문서를 만드는 경로는 **정확히 두 곳**이고
                       //    둘 다 "미지정" 을 쓴다 — 교사 자가가입(Login.js:612)과 문서 유실 시
                       //    자동 재생성(AuthContext.js:506). 학생 계정은 createStudentAccounts CF
                       //    (Admin SDK, rules 우회)가 만든다. 그래서 이 제약의 정상 경로 회귀는 0 이다.
                       //    학급 배정은 승인(handleApproveTeacher) 또는 CF 만 한다.
                       //    ⚠️ update 쪽은 이미 classCode 를 블록리스트로 막고 있었다 — create 만 열려 있었다.
                       request.resource.data.get('classCode', '미지정') == '미지정' &&
                       // 🔒 2026-08-21 전수조사: **update 블록리스트에 있는데 create 에서 안 보던 필드들.**
                       //    이 저장소는 정확히 이 실패모드를 반복했다 — policeReports 에서 "update만 잠그면
                       //    create 로 우회된다"를 배웠는데(2026-07-15) users 에는 적용되지 않았다.
                       //    · 일일 카운터에 **음수**를 심으면 서버의 `count >= limit` 검사가 통과한다
                       //      (completedTasks 는 같은 이유로 이미 막혀 있었다 — 나머지가 빠져 있었다).
                       //    · role 은 클라이언트가 `role === "admin"` 으로 관리자 화면을 여는 데 쓴다.
                       //    정상 가입 경로 두 곳은 이 필드들을 아예 쓰지 않는다 → 회귀 0.
                       !request.resource.data.keys().hasAny([
                         'gameRewardDaily', 'dailyItemUse', 'dailyItemBuy',
                         'dailyDrawCount', 'dailySpinCount', 'role'
                       ]) &&
                       isValidString(request.resource.data.name, 50));

      // 수정: 본인(제한 필드), 또는 관리자
      // - 본인: 중요 필드(아래 hasAny 금지목록: isAdmin·jobs·일일카운터·cash·classCode 등) 제외 수정 가능
      // - 같은 학급 cash 직접 write는 batch7-a(2026-07-18)에서 제거 = 모든 cash 이동은 CF(Admin SDK) 전용
      // - 관리자(승인 교사·슈퍼관리자): 모든 필드 수정 가능(관리도구·cash 조정·학급 이관)
      //
      // 🔒 selectedJobIds / appointedJobIds 는 본인 write 금지 (2026-07-13 FULL 교차검증):
      //    학생이 대통령 등 지정 전용 직업 id를 직접 써넣어 주급 보너스(+200만/주)와
      //    할일 승인·법안 거부권을 자가 획득할 수 있었다. 이제 학생의 직업 선택은
      //    saveSelectedJobs callable(서버 검증: 존재·학급·지정전용 배제·중복 제거·상한)이
      //    유일한 경로이고, 지정 전용 직업은 교사(관리자)만 appointedJobIds에 넣을 수 있다.
      //    delegatedPermissions도 같은 이유로 차단 — 학생이 taskApproval:true를 self-grant 하면
      //    직업 경로를 막아도 같은 권한(할일 승인)을 그대로 얻는다(functions/index.js processTaskApproval).
      //
      // 🔒 일일 한도 카운터(dailyItemUse·dailyItemBuy·dailyDrawCount·dailyDrawDate)도 본인 write 금지:
      //    서버(useUserItem·drawRandomItem 등)가 이 값을 한도 판정에 그대로 신뢰하는데 학생이 스스로
      //    지울 수 있어 하루 사용/구매/뽑기 한도를 무제한 우회할 수 있었다. 클라이언트는 이 필드를
      //    읽지도 쓰지도 않는다(CF 전용 카운터) — 차단해도 정상 기능에 영향 없음(2026-07-14 실측).
      // 🔒 batch7-a (2026-07-18 사용자 결정): cash·classCode 본인/같은학급 직접 write 봉인 = money-glitch cash 직접경로 봉인·학급전환 잠금.
      //  - cash: 모든 cash 이동이 CF(Admin SDK)로 이관 완료(송금·벌금·합의·경매·함께구매·상점·음악·은행·렌트) →
      //    학생 본인 및 같은학급 cash 직접 write 전면 차단(구 same-class 절 제거). 남은 클라 cash write는
      //    admin(교사) 관리도구(handleCollectRent 월세징수·파킹 정산루프)뿐이라 isAdmin()으로 유지.
      //  - classCode: 학생 자가 학급전환 차단(학생 고정 정책). 승인 교사/관리자(isAdmin)·슈퍼관리자만 변경 가능.
      //    (구 설계는 classCode 자가변경=학급참여 기능이라 허용+isApproved 게이트로 완화했으나 사용자가 고정 선택.)
      // 🔒 batch7-b (2026-07-18): coupons 본인 직접 write 봉인 = coupons 자가적립→sellCoupon 현금화 민팅 통로 봉인.
      //    구 규칙은 coupons를 owner-self가 임의 숫자로 쓸 수 있어(coupons is number) updateDoc({coupons:99만})→
      //    sellCoupon(1개=1000원)으로 무한 현금화 가능했다. 모든 학생 coupons 적립/차감을 CF(Admin SDK)로 이관:
      //    게임보상=grantGameReward(chess/omok/typing/transcription/comment, 서버 일일한도·상한), 기부=donateCoupon,
      //    판매=sellCoupon, 선물=giftCoupon. 남은 클라 coupons write는 교사 CouponTransfer(isAdmin)뿐 → isAdmin()으로 유지.
      //    (학생↔학생 직접 coupons write는 원래 rules상 owner|admin만 허용이라 이미 불가였음 — 변경 없음.)
      // 🔒 권한상승 필드 봉인 (2026-07-19 codex CRITICAL): 기존 isAdmin() 분기는 userId 스코프도
      //    필드 제한도 전혀 없어, 승인된 일반 교사(isApproved)가 updateDoc로 자기 문서에 isSuperAdmin:true를
      //    써넣어 슈퍼관리자로 self-escalation하거나(create 규칙은 "isSuperAdmin 자체설정 불가"로 막는데
      //    update가 뚫렸다 = 설계 모순), 임의 학생을 관리자/슈퍼관리자로 승격·강등할 수 있었다.
      //    이제 권한 필드(isSuperAdmin·isAdmin·isApproved·isTeacher·role)는 슈퍼관리자만 write 가능.
      //    일반 관리자(교사)는 cash·coupons·직업 등 학급 운영 필드는 그대로 수정 가능(설계 유지).
      //    실측(2026-07-19): 권한 필드를 쓰는 정상 클라 경로는 슈퍼관리자(SuperAdminDashboard isApproved)와
      //    교사 가입(create 규칙)뿐 → 이 봉인은 정상 기능 무영향.
      // 🏫 Phase1(2026-07-19 확정): classCode를 관리자 블록리스트에 추가 + isSameClass(resource.data.classCode)로
      //    관리자 분기를 '자기 학급' 스코프. "한 교사 = 한 학급" 결정에 따라 (1) 교사가 타 학급 학생을 조작하는
      //    경로와 (2) 교사가 자기 classCode를 바꿔 타 학급으로 hop하는 cross-class 경로를 함께 봉인.
      //    classCode 변경은 이제 슈퍼관리자 전용(아래 || isSuperAdmin). 교사용 "학급 코드 변경" UI
      //    (AlchanHeader/MyProfile)도 같은 커밋에서 슈퍼관리자 전용으로 게이팅해 깨진 버튼 미노출(code-reviewer 지적).
      allow update: if (isOwner(userId) &&
                        // 🔒 2026-08-11 추가: 'email' · 'isTestAccount'
                        //   email — 문서 생성 시에만 쓰인다(AuthContext 신규생성 · StudentManager 일괄생성).
                        //     클라이언트가 기존 문서의 email 을 수정하는 경로는 0건이라 막아도 회귀 없다.
                        //   isTestAccount — sellStock 의 '매수 후 1시간 매도잠금' 우회 플래그.
                        //     학생이 self-grant 하면 잠금을 스스로 풀 수 있으므로 관리자 전용이어야 한다.
                        // 🔒 2026-08-12 추가: 주기작업 **멱등 마커**
                        //   lastSalaryWeekKey / lastWeeklyTaxWeekKey 는 "이번 주 이미 지급/징수됨"을
                        //   뜻해서, 스케줄러가 그 학생을 건너뛰는 근거로 쓴다. 학생이 직접 쓸 수 있으면
                        //   **세금을 안 내는 통로**가 된다(자기 문서에 이번 주 키만 박으면 징수를 건너뛴다).
                        //   🔒 2026-08-12 2차 추가(codex): 서버가 **한도·제한 판정에 쓰는** 필드들.
                        //     dailySpinDate/dailySpinCount — 지우면 하루 3회 추첨 한도를 무한 반복
                        //     lastIncomingTransferAt — 지우면 송금 수령 후 24h 대출상환 제한 우회
                        //     lastLoanRepaidAt — 지우면 완납 후 24h 재대출 제한 우회
                        //     totalSalaryReceived — 위조 후 백필 실행 시 급여 감사로그가 위조액으로 생성
                        //     🔬 전부 클라이언트 write 0건 확인(src 전수) — 막아도 회귀 없다.
                        //   같은 계열의 다른 마커는 이미 안전하다 — 적금 lastDepositDate 는 products
                        //   (교사 전용 write), 배당 dividendPaidMonths 는 portfolio(create/update:false).
                        //   user 문서에 얹는 마커만 여기서 막으면 된다.
                        //   🔒 2026-08-21 추가(AAP P1-2): `appRewardDaily`
                        //     학습앱 보상의 **학생×전체×일** 합계다. 서버가 이 값을 캡 판정에
                        //     그대로 신뢰하므로, 학생이 쓸 수 있으면 스스로 0 으로 되돌려
                        //     하루 한도를 무한 우회한다. 이 저장소는 같은 실패를 이미 겪었다
                        //     (user 문서 마커 → 세금 회피 통로). 클라이언트는 이 필드를
                        //     읽지도 쓰지도 않는다(CF 전용 카운터) — 막아도 회귀 없다.
                        //     ⚠️ create 쪽도 같이 막는다(아래) — update 만 잠그면
                        //     음수를 심은 채 문서를 만들어 한도를 **늘릴** 수 있다.
                        //   ⚠️ `pendingTaxSummary` 는 **일부러 뺐다** — 학생이 주간 세금 팝업을
                        //   "확인"으로 닫을 때 본인이 `deleteField()` 로 지운다
                        //   (WeeklyTaxSummaryPopup.js:26). 막으면 팝업이 안 닫힌다.
                        //   위조해 봐야 자기 화면의 안내 문구가 바뀔 뿐 징수액은 서버가 계산한다.
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'isSuperAdmin', 'isTeacher', 'isApproved', 'role', 'selectedJobIds', 'appointedJobIds', 'jobName', 'jobTitle', 'delegatedPermissions', 'dailyItemUse', 'dailyItemBuy', 'dailyDrawCount', 'dailyDrawDate', 'gameRewardDaily', 'cash', 'classCode', 'coupons', 'completedTasks', 'completedJobTasks', 'tasksResetDate', 'email', 'isTestAccount', 'lastSalaryWeekKey', 'lastWeeklyTaxWeekKey', 'lastSalaryDate', 'lastNetSalary', 'lastGrossSalary', 'lastTaxAmount', 'dailySpinDate', 'dailySpinCount', 'lastIncomingTransferAt', 'lastLoanRepaidAt', 'totalSalaryReceived', 'appRewardDaily']) &&
                        // 필드 유효성 검증
                        (!('nickname' in request.resource.data) || isValidString(request.resource.data.nickname, 20))) ||
                       (isAdmin() &&
                        // 🏫 Phase1(2026-07-19): 관리자 cash/coupons/직업 등 수정은 '자기 학급 학생'으로 스코프.
                        //   기존엔 isSameClass 검사가 없어 교사 A가 타 학급(B) 학생의 cash를 직접 조정할 수 있었다.
                        //   resource.data.classCode = 대상 학생의 기존 학급(교사 자신 문서면 자기 학급)이라 자기 반만 통과.
                        isSameClass(resource.data.classCode) &&
                        // classCode를 블록리스트에 추가 = 학생 학급이동(자기변경)은 슈퍼관리자 전용(아래 || isSuperAdmin).
                        //   "한 교사 = 한 학급" 확정 → 교사가 학생을 타 학급으로 옮기는 경로 봉인(정상 이동=슈퍼관리자).
                        //   실측: 학생 classCode를 클라에서 바꾸는 교사 도구 없음(일괄생성=createStudentAccounts CF) → 회귀 0.
                        // 🔒 2026-08-21 (AAP P1-2 · codex CRITICAL, ALLOW 카나리아로 재현 확인):
                        //   `appRewardDaily` 를 **교사 분기에도** 넣는다. 학생 분기만 막아 뒀더니
                        //   같은 학급 승인 교사가 학생 문서의 이 필드를 0 으로 되돌려 **AAP 하루 상한을
                        //   무제한 재발급**할 수 있었다(학생이 앱 10개로 10만원을 채운 뒤 교사가 리셋 → 계속).
                        //   ⚠️ "교사는 어차피 cash 를 직접 올릴 수 있으니 같은 것 아니냐"는 반론이 있다.
                        //     다르다. cash 직접 조정은 **교사가 스스로 금액을 정하는** 행위이고 감사 대상이지만,
                        //     이 필드를 여는 것은 **위성앱에게 무제한 발행 권한을 넘기는** 일이다. 캡은 교사가 아니라
                        //     자동 지급 채널을 향한 방어선이다. 그리고 이 필드를 쓰는 정당한 교사 UI 는 **0곳**이다.
                        //   ⚠️ 같은 모양의 기존 카운터(gameRewardDaily·dailyItemUse·dailyDrawCount·dailySpinCount)도
                        //     교사 분기에는 빠져 있다. 그건 이번 변경 범위 밖의 **선재 항목**이라 대장에 적어 둔다.
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isSuperAdmin', 'isAdmin', 'isApproved', 'isTeacher', 'role', 'classCode', 'appRewardDaily'])) ||
                       isSuperAdmin();

      // 🔒 batch7-f (2026-07-18 사용자 결정: 관리자 전용 삭제): 삭제는 isAdmin()만 허용(학생 self-delete 차단).
      //    구 `isOwner || isAdmin`은 학생이 updateDoc/deleteDoc으로 자기 user 문서를 직접 지울 수 있어,
      //    삭제 후 AuthContext가 fresh 문서를 auto-recreate(coupons:0·gameRewardDaily 없음)하는 순간
      //    모든 서버 일일카운터(gameRewardDaily·dailyItemUse/Buy·dailyDrawCount)가 리셋 → grantGameReward
      //    게임보상·아이템/뽑기 한도를 무제한 반복 파밍하는 마스터키 우회였다(codex CRITICAL, batch7-b 발견).
      //    계정삭제는 관리자(StudentManager/SuperAdmin) 전용으로 일원화 — MyProfile 학생 자가삭제 UI는 admin-gate.
      // 🏫 Phase1(2026-07-19 codex 커버리지): 자기 학급 학생만 삭제(user 문서 classCode 필드로 스코프).
      //    기존 isAdmin()은 교사 A가 타 학급 학생 계정을 삭제 가능. StudentManager 단일/일괄삭제 모두 자기 학급 대상.
      allow delete: if isClassAdmin(resource.data.classCode);

      // ========================================================
      // 💰 거래 기록 서브컬렉션 (users/{userId}/transactions/{transactionId})
      // ========================================================
      match /transactions/{transactionId} {
        allow read: if isOwner(userId) || isAdminFast();
        // 생성: 본인 또는 같은 학급 사용자 (송금 시 상대방 거래 기록 생성 가능)
        allow create: if isOwner(userId) ||
                         (isSignedIn() &&
                          isSameClass(get(/databases/$(database)/documents/users/$(userId)).data.classCode));
        allow update: if false; // 거래 기록은 수정 불가
        allow delete: if isClassAdminOfUser(userId); // 🏫 Phase1: 자기 학급 학생만
      }

      // ========================================================
      // 📈 주식 포트폴리오 서브컬렉션 (users/{userId}/portfolio/{stockId})
      // ========================================================
      match /portfolio/{stockId} {
        allow read: if isOwner(userId) || isSameClassFast(get(/databases/$(database)/documents/users/$(userId)).data.classCode) || isAdminFast();
        // 🔒 batch7-d (2026-07-18 codex CRITICAL): 매수/매도는 buyStock/sellStock CF(Admin SDK, rules 우회) 전용.
        //    학생이 portfolio 문서의 quantity/avgPrice를 직접 위조하면 sellStock CF가 그 수량만큼 cash를 지급
        //    (무담보 민팅)했다. create/update를 CF 전용(if false)으로 잠가 위조 차단. delete만 유지 —
        //    StockExchange deleteHolding(휴지조각 정리)은 자산 감소라 민팅 벡터 아님.
        allow create, update: if false;
        allow delete: if isOwner(userId) || isClassAdminOfUser(userId); // 🏫 Phase1: 관리자는 자기 학급만
      }

      // ========================================================
      // 💎 배당 멱등 원장 (users/{userId}/dividendLedger/{monthKey})
      // ========================================================
      // "이 학생이 이번 달 어느 종목 배당을 받았는가"의 기록. 배당 CF 가 지급과 같은 batch 로 쓴다.
      // 🔒 학생이 쓸 수 있으면 **아직 안 받은 종목을 '받았다'고 심어 지급을 건너뛰게** 하거나
      //    (자해), 지운 뒤 재실행을 유도해 **두 번 받을** 수 있다. 전부 CF(Admin SDK) 전용이다.
      //    delete 도 막는다 — 원장을 지우는 것이 곧 재지급 통로다(portfolio 와 달리 자산 감소가 아니다).
      match /dividendLedger/{monthKey} {
        allow read: if isOwner(userId) || isAdminFast();
        allow write: if false;
      }

      // ========================================================
      // 📦 인벤토리 서브컬렉션 (users/{userId}/inventory/{itemId})
      // ========================================================
      // 📅 메타 서브컬렉션 (출석 스트릭 등)
      match /meta/{metaId} {
        allow read: if isOwner(userId) || isAdminFast();
        allow write: if isOwner(userId) || isClassAdminOfUser(userId); // 🏫 Phase1: 관리자는 자기 학급만
      }

      match /inventory/{itemId} {
        // 읽기: 본인, 관리자, 또는 같은 학급 사용자 (아이템 선물 기능을 위해)
        allow read: if isOwner(userId) || isAdminFast() || (isSignedIn() && isSameClassFast(get(/databases/$(database)/documents/users/$(userId)).data.classCode));
        // 🔒 batch7-e (2026-07-18 codex CRITICAL): inventory write를 CF 전용(if false)으로 잠금.
        //    구 `isOwner||isAdmin`은 학생이 inventory에 effect.type:"cash"·value:10억 아이템을 위조 삽입 후
        //    useUserItem CF로 그 값만큼 cash를 지급받는 무담보 민팅 통로였다(codex). 구매/사용/선물/뽑기/
        //    함께구매 지급은 전부 CF(purchaseStoreItem·useUserItem·giftItem·drawRandomItem·completeGroupPurchase,
        //    Admin SDK로 rules 우회)가 정식 경로라 회귀 없음. GroupPurchase 클라 폴백(GroupPurchase.js:292)은
        //    이제 항상 403 → outer catch "관리자 문의"로 우아하게 강등(CF가 트랜잭션 지급이라 폴백은 잉여·P4 정리 대상).
        //    2026-07-10 무기록 아이템 이동/증발 재발 방지도 겸함.
        //    ⚠️ delete는 isAdmin() 허용 — StudentManager.js 학생 일괄삭제가 서브컬렉션을 클라 deleteDoc으로
        //       정리하므로(관리자 실행), 학생 위조(create/update)만 차단하고 관리자 delete는 유지(자산 감소=무해).
        allow create, update: if false;
        allow delete: if isClassAdminOfUser(userId); // 🏫 Phase1: 자기 학급 학생만
      }

      // ========================================================
      // 🎯 완료된 과제 서브컬렉션 (users/{userId}/completedTasks/{taskId})
      // ========================================================
      match /completedTasks/{taskId} {
        allow read: if isOwner(userId) || isAdminFast();
        allow write: if isOwner(userId) || isClassAdminOfUser(userId); // 🏫 Phase1: 관리자는 자기 학급만
      }

      // ========================================================
      // 💰 금융 정보 서브컬렉션 (users/{userId}/financials/{document})
      // ========================================================
      match /financials/{document} {
        allow read: if isOwner(userId) || isAdminFast();
        // 🔒 batch7-c (2026-07-18 codex CRITICAL): financials write를 CF 전용(if false)으로 잠금.
        //    구 `isOwner||isAdmin`은 학생이 parkingAccount.balance를 임의 위조 → parkingWithdraw CF가
        //    저장 balance를 신뢰해 그만큼 cash를 지급(무담보 민팅)하는 통로였다. 파킹 입출금(parkingDeposit/
        //    parkingWithdraw)·이자적립(accrueParkingInterest)이 전부 CF(Admin SDK)라 회귀 없음.
        //    ⚠️ delete는 isAdmin() 허용 — StudentManager.js 학생 일괄삭제가 financials를 클라 deleteDoc으로
        //       정리하므로(관리자 실행). 학생 위조(create/update)만 차단하고 관리자 delete는 유지.
        allow create, update: if false;
        allow delete: if isClassAdminOfUser(userId); // 🏫 Phase1: 자기 학급 학생만
      }

      // ========================================================
      // 📦 가입 상품 서브컬렉션 (users/{userId}/products/{productId})
      // ⚠️ 2026-07-17 학생(isOwner) 직접 write 제거 — 예적금/대출 가입·만기·해지·상환·자동납입이
      //    전부 서버 CF(subscribeProduct/redeemDepositSavings/repayLoan/autoSavingsDeposit, Admin SDK로
      //    rules 우회)로 이관 완료. 학생이 balance/rate/teacherId/maturityDate/depositsCount/totalDeposited를
      //    직접 위조해 CF가 그 값으로 이자·상환·지급을 계산하던 벡터(3계열 CRITICAL) 봉인. 교사(isAdmin)
      //    force-delete는 유지. (cash 자체 위조는 별개 — batch6 cash rules 잠금 대상.)
      // ========================================================
      match /products/{productId} {
        allow read: if isOwner(userId) || isAdminFast();
        allow write: if isClassAdminOfUser(userId); // 🏫 Phase1: 관리자 force-delete는 자기 학급만
      }

      // ========================================================
      // 💸 대출 서브컬렉션 (users/{userId}/loans/{loanId})
      // ========================================================
      // 🔒 2026-08-11: 형제 경로가 전부 봉인됐는데 여기만 학생 write 가 열려 있었다.
      //   financials(:360 create,update:false) · products(:374 isClassAdminOfUser) 는 **같은 사고**
      //   — 학생이 잔액을 위조하면 CF 가 그 값을 신뢰해 지급 — 로 이미 각각 잠갔다. loans 만 빠졌다.
      //   실측: 이 경로를 읽는 코드 0 · 쓰는 코드 0(Banking.js 의 firestoreType="loans" 는
      //   bankingSettings/{classCode} 교사 상품 카탈로그로 가지 이 경로가 아니다).
      //   대출 잔액의 실제 소스는 users/{uid}/products(type=loan)이고 그쪽은 잠겨 있다.
      //   즉 죽은 경로 + 열린 규칙 — 형제와 같은 기준으로 통일한다.
      match /loans/{loanId} {
        allow read: if isOwner(userId) || isAdminFast();
        allow write: if isClassAdminOfUser(userId); // 🏫 Phase1: 관리자는 자기 학급만
      }

      // ========================================================
      // ⚙️ 사용자 설정 서브컬렉션 (users/{userId}/settings/{settingId})
      // 튜토리얼 상태, 테마 등 사용자 개인 설정
      // ========================================================
      match /settings/{settingId} {
        allow read: if isOwner(userId) || isAdminFast();
        allow write: if isOwner(userId) || isClassAdminOfUser(userId); // 🏫 Phase1: 관리자는 자기 학급만
      }

      // ========================================================
      // 🏅 배지 서브컬렉션 (users/{userId}/badges/{document})
      // ========================================================
      match /badges/{document} {
        allow read: if isOwner(userId) || isAdminFast();
        allow write: if isOwner(userId) || isClassAdminOfUser(userId); // 🏫 Phase1: 관리자는 자기 학급만
      }

      // ========================================================
      // 🏠 부동산 서브컬렉션 (users/{userId}/properties/{propertyId})
      // ========================================================
      match /properties/{propertyId} {
        allow read: if isOwner(userId) || isAdminFast();
        allow write: if isOwner(userId) || isClassAdminOfUser(userId); // 🏫 Phase1: 관리자는 자기 학급만
      }

      // ========================================================
      // 📋 활동 로그 서브컬렉션 (users/{userId}/activityLogs/{logId})
      // 경매 낙찰/유찰 등 활동 기록
      // ========================================================
      match /activityLogs/{logId} {
        allow read: if isOwner(userId) || isAdminFast();
        allow create: if isSignedIn();
        allow update, delete: if isClassAdminOfUser(userId); // 🏫 Phase1: 관리자는 자기 학급만
      }
    }

    // ========================================================
    // 🗑️ ClassStock 학생 자산 경로 폐기 (2026-08-03, Phase 1 이중경로 정리)
    //   구 규칙은 `allow write: if isOwner(userId)` 라 학생이 자기 경로에 가짜 부동산·
    //   파킹잔액을 써넣을 수 있었고, MyAssets 가 그걸 표시용 폴백으로 읽어 **화면상 자산을
    //   부풀릴 수** 있었다(세금·순자산 정식 계산은 netAssets.js 가 이 경로를 안 읽어 무영향).
    //
    //   실측(프로덕션 전수, 학급 7개·학생 88명): 이 경로들의 문서는 **전부 0건**.
    //   같은 날 MyAssets 의 폴백 읽기도 제거해 코드 참조가 0이 됐다.
    //
    //   정식 소스: 부동산 = classes/{classCode}/realEstateProperties (owner==uid, 관리자만 write)
    //             파킹   = users/{uid}/financials/parkingAccount (batch7-c 로 CF 전용)
    //             주식   = users/{uid}/portfolio (batch7-d 로 CF 전용)
    //
    //   ⚠️ 아래 `if false` 블록은 **문서화용**이다(schedulerLocks 와 같은 관례).
    //      실측 확인(2026-08-03): Firestore 규칙은 매칭되는 규칙 중 하나라도 허용하면 허용이라,
    //      명시적 `if false` 는 나중에 누가 `ClassStock/{cc}/{document=**}` 같은 넓은 허용
    //      규칙을 추가하는 것을 **막지 못한다**. 실제 봉인은 파일 끝 포괄 `if false` 와
    //      `npm run test:rules` 의 거부 테스트가 담당한다. 이 블록의 값어치는 ClassStock
    //      규칙을 고치러 온 사람이 1000줄 떨어진 포괄 규칙 대신 여기서 폐기 사실을 본다는 것.
    // ========================================================
    match /ClassStock/{classCode}/portfolio/{userId}/{document=**} {
      allow read, write: if false; // 폐기 — 정식 소스는 users/{uid}/portfolio
    }
    match /ClassStock/{classCode}/students/{userId}/{document=**} {
      allow read, write: if false; // 폐기 — 부동산/파킹 정식 소스는 위 주석 참조
    }

    // ========================================================
    // 💹 주식 정보 (ClassStock/{classCode}/stocks/{stockId})
    // ========================================================
    match /ClassStock/{classCode}/stocks/{stockId} {
      allow read: if isSameClassFast(classCode);
      allow write: if isClassAdmin(classCode); // 🏫 Phase1: 자기 학급 주가만(타 학급 주가 조작 차단)
    }

    // ========================================================
    // 📰 뉴스 (ClassStock/{classCode}/news/{newsId})
    // ========================================================
    match /ClassStock/{classCode}/news/{newsId} {
      allow read: if isSameClassFast(classCode);
      allow write: if isClassAdmin(classCode); // 🏫 Phase1: 자기 학급 뉴스만
    }

    // ========================================================
    // 🏢 중앙 주식 시장 (CentralStocks)
    // ========================================================
    match /CentralStocks/{stockId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /CentralNews/{newsId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ========================================================
    // 📊 시장 상황 (MarketCondition)
    // ========================================================
    // ⚠️ 죽은 컬렉션 (2026-08-17 하드닝). 라이브 1건(잔재) · 참조 0건 —
    //    이 문서를 갱신하던 updateMarketConditionLogic 은 이미 제거됐다(scheduler-http.js:2058 주석).
    match /MarketCondition/{conditionId} {
      allow read: if false;
      allow write: if false;
    }

    // ========================================================
    // 🏪 상점 아이템 (storeItems)
    // ========================================================
    match /storeItems/{itemId} {
      // 🔒 읽기 학급 스코프 (2026-08-17). 종전 `if isSignedIn()` 은 "클라가 항상
      //   where(classCode == 자기학급) 로만 조회하니까" 를 전제로 열려 있었다 — 클라이언트 쿼리는
      //   보안 통제가 아니다. 필터 없는 getDocs(collection(db,'...')) 한 줄이면 전국 학급 문서가
      //   그대로 나온다. 쓰기는 2026-07-19 하드닝에서 resource.data.classCode 로 이미 잠갔고,
      //   읽기만 같은 필드를 안 보고 있었다(감사 3회가 놓친 이유: 헬퍼 호출 횟수를 셌기 때문).
      //   클라 조회(getStoreItems·SuperAdmin·학급복사) 전부 classCode 필터 실측 → 회귀 0.
      allow read: if isSignedIn() && (isAdminFast() || isSameClassFast(resource.data.classCode));
      // 🏫 Phase1(2026-07-19): storeItems는 classCode 필드 보유(전수 실측) → 자기 학급 카탈로그만 관리.
      //   create=신규 아이템의 classCode, update/delete=기존 아이템의 classCode로 스코프. 앱은 storeItems를
      //   항상 where(classCode==자기학급)로만 조회하므로 classCode 없는 문서는 UI에 노출 불가(회귀 0).
      allow create: if isClassAdmin(request.resource.data.classCode);
      // 🏫 Phase1(codex+Gemini CRITICAL): update 시 classCode 동결 — 자기 학급 문서의 classCode만 바꿔
      //   타 학급 카탈로그로 이동시키는 위조 차단(구매/직업/할일 CF가 이동된 문서를 정상 취급). 이관은 슈퍼관리자도 delete+재생성.
      allow update: if isClassAdmin(resource.data.classCode) &&
                       request.resource.data.classCode == resource.data.classCode;
      allow delete: if isClassAdmin(resource.data.classCode);
    }

    // ========================================================
    // 🧩 플랫폼 앱 레지스트리 (platformApps) — 2026-08-17 신설
    //    사이드바의 학습 사이트 목록. 종전엔 AlchanSidebar.js 에 10개가 하드코딩돼 있어
    //    앱 하나 추가가 코드 배포였다. 이제 `platformApps/_registry` 문서 하나가 정본이다.
    //    · 읽기 = 로그인 전원(학급 무관한 공용 카탈로그, 개인정보 아님).
    //      비용: 클라가 브라우저 세션당 1회만 읽는다(learningAppRegistry.js 세션 캐시).
    //    · 쓰기 = 슈퍼관리자만. 교사가 만지면 **전국 사이드바**가 바뀐다.
    //      학급별 on/off 는 여기가 아니라 settings/menuLocks_{classCode} 가 담당한다.
    //    ⚠️ 앞으로 "누가 어떤 앱에 보상을 줄 수 있나" 같은 **집행 정책**은 이 문서에 넣지 말 것.
    //       표시용 카탈로그(캐시됨)와 집행 정책(캐시 금지·즉시 반영)은 분리해야 한다.
    // ========================================================
    match /platformApps/{docId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ========================================================
    // 🧩 앱별 **집행 정책** (platformAppPolicies) — 2026-08-20 신설 (AAP v1)
    //    위 platformApps 주석이 예고한 분리다. 표시용 카탈로그와 집행 정책은 다른 물건이다:
    //    · 카탈로그는 브라우저 세션당 1회 **캐시**된다 → 여기에 kill switch 를 넣으면
    //      앱을 끈 뒤에도 캐시가 살아 있는 학생에겐 계속 켜져 있다.
    //    · 그래서 정책은 앱별 문서로 두고 서버가 **실행/지급 때마다 직접** 읽는다(캐시 금지).
    //    담는 것: status(kill switch) · aapEnabled · launchUrl · trustLevel · 보상 캡 · allowedClaims.
    //    ⚠️ launchUrl 이 여기 있는 이유 = 실행 URL 을 요청자가 정하면 fragment 의 토큰을
    //       공격자 사이트로 보낼 수 있다. **서버가 정한다**(계획서 §3.2 C6).
    //    · 읽기 = 슈퍼관리자만. 학생·교사는 이 값을 알 필요가 없고, 캡을 노출하면
    //      "얼마까지 긁을 수 있는지"를 알려주는 셈이다. 서버(Admin SDK)는 규칙을 우회한다.
    //    · 쓰기 = 슈퍼관리자만. 전국 모든 학급의 앱 실행·보상이 이 문서에 달려 있다.
    // ========================================================
    match /platformAppPolicies/{appId} {
      allow read: if isSuperAdminFast();
      allow write: if isSuperAdmin();
    }

    // ========================================================
    // 🏅 앱별 **성취 카탈로그** (appAchievements) — 2026-08-20 신설 (AAP v1 · P1-7)
    //    "무엇을 얼마에 준다"를 서버만 안다. 클라이언트는 achievementId 만 보낸다.
    //    ⚠️ 초안 설계는 클라가 amount 를 보내고 서버가 캡으로 막는 모양이었는데, 그러면
    //       **캡이 방어가 아니라 가격표가 된다** — 공격자는 매일 확정적으로 최대치를 가져간다
    //       (계획서 §2.4 A1).
    //    ⚠️ 이름: `src/utils/achievementSystem.js`(로컬 배지, 돈 무관)와 **다른 물건**이다.
    //       그래서 컬렉션 이름을 achievements 가 아니라 appAchievements 로 두었다.
    //    · 읽기 = 슈퍼관리자만. 학생이 금액표를 읽을 수 있으면 "어느 성취가 제일 비싼지"를
    //      먼저 알고 그것만 노린다. 서버(Admin SDK)는 규칙을 우회하므로 지급에는 지장이 없다.
    //    · 쓰기 = 슈퍼관리자만. 교사 계정이 털려도 금액을 못 바꾼다(계획서 §2.4 A8).
    //      코드의 절대 상한(functions/aap/catalog.js HARD_CEILING)이 최종 방어선이다 —
    //      이 문서 값이 그걸 넘으면 지급이 **거부**된다(조용히 깎지 않는다).
    // ========================================================
    match /appAchievements/{appId} {
      allow read: if isSuperAdminFast();
      allow write: if isSuperAdmin();

      match /items/{achievementId} {
        allow read: if isSuperAdminFast();
        allow write: if isSuperAdmin();
      }
    }

    // ========================================================
    // 💸 AAP 보상 지급 계열 (2026-08-21 신설 · P1-2) — **전부 서버 전용**
    //
    //    다섯 컬렉션이 한 세트다. 하나라도 클라이언트에 열리면 나머지 넷의 방어가 무의미해진다.
    //      · aapRewardSessions/{jti}          1회용 실행권. uid ↔ 토큰을 잇는 유일한 다리이고,
    //                                          consumedGrantId 가 재생 방어의 전부다.
    //      · appRewardGrants/{requestHash}    지급 **원장**(append-only) 겸 멱등 레코드.
    //                                          문서 id 가 곧 멱등키라 두 물건이 하나다.
    //      · appRewardSubjects/{uid}_{appId}  학생×앱×일 합계 + 성취별 상태(횟수·쿨다운).
    //      · appRewardCounters/{day}_{scope}  학급×일 · 앱×일 합계(폭주 차단기).
    //      · aapRateLimits/{uid}_{appId}      token bucket.
    //
    //    ⚠️ 읽기도 닫는다. 학생이 자기 카운터를 **읽을** 수 있으면 "얼마 남았는지"를 알고
    //       그 선까지 정확히 긁는다. 교사 화면(P1-5)은 서버 집계를 통해 본다.
    //    ⚠️ 서버는 Admin SDK 라 이 규칙을 우회한다 — 지급에는 지장이 없다.
    //       바꿔 말하면 **이 컬렉션들의 진짜 방어는 rules 가 아니라 지급 코드 안의 캡**이다
    //       (functions/aap/rewardRules.js). rules 는 "클라이언트는 손도 못 댄다"만 보장한다.
    // ========================================================
    match /aapRewardSessions/{jti} {
      allow read, write: if false;
    }
    match /appRewardGrants/{grantId} {
      allow read, write: if false;
    }
    match /appRewardSubjects/{subjectId} {
      allow read, write: if false;
    }
    match /appRewardCounters/{counterId} {
      allow read, write: if false;
    }
    match /aapRateLimits/{bucketId} {
      allow read, write: if false;
    }

    // ========================================================
    // 🏪 카탈로그 버전 (catalogMeta) — 상점 변경 실시간 전파용.
    //    학생은 같은 학급 문서 1개만 onSnapshot으로 읽음.
    //    쓰기는 Cloud Function(Admin SDK, rules 우회) 전용.
    // ========================================================
    match /catalogMeta/{classCode} {
      allow read: if isSameClassFast(classCode);
      allow write: if false;
    }

    // ========================================================
    // 🎭 아바타 상점 아이템 (avatarShopItems) - 전 학급 공용
    // ========================================================
    match /avatarShopItems/{itemId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ========================================================
    // 🛒 마켓 아이템 (marketItems)
    // ========================================================
    match /marketItems/{listingId} {
      // 읽기: 같은 학급만 (판매자 정보 타 학급 노출 방지)
      allow read: if isSameClassFast(resource.data.classCode) || isAdminFast();
      allow create: if isSignedIn() && isOwner(request.resource.data.sellerId);
      allow update: if isSignedIn() &&
                       (isOwner(resource.data.sellerId) ||
                        isOwner(resource.data.buyerId) ||
                        isAdmin());
      allow delete: if isOwner(resource.data.sellerId) || isAdmin();
    }

    // ========================================================
    // 📝 활동 로그 (activity_logs)
    // ========================================================
    match /activity_logs/{logId} {
      allow read: if isSignedIn() && (isSameClassFast(resource.data.classCode) || isAdminFast());
      // 🔥 완화 (2026-05): 거래 양쪽 모두 같은 트랜잭션에서 로그 생성 필요
      //   기존: 본인 로그만 → 송금/경매/상점 상대방 로그가 생성 안 되어 트랜잭션 실패
      //   변경: 같은 학급이면 누구 userId의 로그도 생성 가능. 단 metadata 검증으로 악용 차단:
      //         · classCode = 본인 학급 (타 학급 로그 위조 차단)
      //         · userId is string (필수)
      //         · description ≤ 500자 (스팸 차단)
      //         · amount는 number이고 ±100억 이하 (비현실적 금액 차단)
      //           (2026-06-12: ±1억 → ±100억 상향. 학급경제 인플레이션으로 함께구매 잔여액이
      //            1억을 초과하면 기여 트랜잭션 전체가 거부되는 실사고 발생 — 자유시간 가격은
      //            완료마다 2배 인상되어 다음 캠페인은 3.2억)
      allow create: if isAdmin() ||
                       (isSignedIn() &&
                       request.resource.data.classCode == getUserClassCode() &&
                       request.resource.data.userId is string &&
                       isValidString(request.resource.data.description, 500) &&
                       (!('amount' in request.resource.data) ||
                        (request.resource.data.amount is number &&
                         request.resource.data.amount >= -10000000000 &&
                         request.resource.data.amount <= 10000000000)));
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ========================================================
    // 🏛️ 정부 설정 (governmentSettings)
    // ========================================================
    match /governmentSettings/{classCode} {
      allow read: if isSameClassFast(classCode);
      allow write: if isClassAdmin(classCode); // 🏫 Phase1: 자기 학급 정부설정만
    }

    // 🏛️ 정부 문서 (governments) — 아바타 상점 학급별 가격 override 등.
    //   클라이언트는 읽기만(같은 학급), 쓰기는 Cloud Function(admin) 전용.
    match /governments/{classCode} {
      allow read: if isSameClassFast(classCode);
      allow write: if isClassAdmin(classCode); // 🏫 Phase1: 자기 학급 정부문서만
    }

    // ========================================================
    // 🏦 국고 (nationalTreasuries)
    // ========================================================
    match /nationalTreasuries/{classCode} {
      allow read: if isSameClassFast(classCode) || isAdminFast();
      // 관리자는 전체 write. 같은 학급 사용자는 통계(세수·수수료) 필드만 — 거래 시 클라가 revenue를
      //   increment한다. 과거 하단 중복 match 블록(삭제됨)이 같은 학급에 '전체 문서' write를 열어
      //   임의 필드 주입이 가능했던 것을 treasuryStatKeys()로 제한(2026-07-19).
      // 🏫 Phase1(2026-07-19): 관리자 전체 write도 자기 학급으로 스코프(isClassAdmin) — 교사 A가
      //   타 학급 국고 통계를 조작하지 못하게. 슈퍼관리자는 isClassAdmin 안에서 전 학급 유지.
      allow create: if isClassAdmin(classCode) ||
                       (isSameClass(classCode) &&
                        request.resource.data.keys().hasOnly(treasuryStatKeys().concat(['createdAt'])));
      allow update: if isClassAdmin(classCode) ||
                       (isSameClass(classCode) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(treasuryStatKeys()));
      allow delete: if isClassAdmin(classCode);
    }

    // ========================================================
    // 🏦 은행 상품 설정 (bankingSettings)
    // ========================================================
    match /bankingSettings/{classCode} {
      allow read: if isSameClassFast(classCode);
      allow write: if isClassAdmin(classCode); // 🏫 Phase1: 자기 학급 은행설정만
    }

    // ========================================================
    // 🎁 기부 기록 (donations)
    // ========================================================
    match /donations/{donationId} {
      allow read: if isSameClassFast(resource.data.classCode) || isAdminFast();
      allow create: if isSignedIn() && isOwner(request.resource.data.donorId);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ========================================================
    // ⚖️ 정산 기록 (settlements)
    // ========================================================
    match /settlements/{settlementId} {
      allow read: if isSameClassFast(resource.data.classCode) || isAdminFast();
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ========================================================
    // 🏘️ 부동산 (realEstate)
    // ========================================================
    // ⚠️ 죽은 컬렉션 (2026-08-17 하드닝). 라이브 문서 0건 · src/·functions/ 참조 0건 —
    //    실사용 경로는 /realEstateProperties 다. 2026-07-19 하드닝 때 auctions·treasury·
    //    nationalTax 는 잠갔는데 여기만 빠졌다. 종전 규칙은 read 전역 공개 + update 가
    //    resource.data.ownerId 만 봐서 학급 경계가 없었다(누군가 top-level 조회 로직을
    //    다시 붙이는 순간 부활하는 지뢰). 되살릴 땐 이 블록을 지우지 말고 스코프를 넣을 것.
    match /realEstate/{propertyId} {
      allow read: if false;
      allow write: if false;
    }

    // ========================================================
    // ⚖️ 재판 (trials)
    // ========================================================
    // ⚠️ 죽은 컬렉션 (2026-08-17 하드닝). 라이브 문서 0건 · 참조 0건 — 실사용 경로는 /trialRooms.
    //    종전 `create: if isSignedIn()` 은 로그인한 학생이 아무 학급으로나 문서를 무제한 생성할 수
    //    있는 상태였다(기능은 0, 쓰기 공격면만 열림 — 2026-08-03 games 컬렉션과 같은 패턴).
    match /trials/{trialId} {
      allow read: if false;
      allow write: if false;
    }

    // ========================================================
    // 🎯 경매 (auctions)
    // ========================================================
    // ⚠️ 죽은 top-level 컬렉션(실사용 경로 = classes/{classCode}/auctions, 873행). 어떤 클라·CF·
    //    collectionGroup 쿼리도 이 top-level /auctions를 읽거나 쓰지 않음(code-reviewer 확인).
    //    다만 구 규칙이 nested와 동일한 fake-escrow 패턴(update: isSameClass)을 방치 → 향후 누군가
    //    top-level 조회 로직을 추가해도 취약점이 부활하지 않도록 nested 잠금형과 동일하게 하드닝.
    match /auctions/{auctionId} {
      // 🔒 2026-08-17: 쓰기는 잠갔는데 읽기가 전역으로 남아 있었다(라이브 1건 잔재 · 참조 0건).
      allow read: if false;
      // 죽은 top-level 컬렉션 — 실사용 경로는 classes/{classCode}/auctions(873). 어떤 클라·CF도
      //   이 경로에 쓰지 않으므로 create/update 전면 차단(landmine 제거).
      allow create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /auctions/{auctionId}/bids/{bidId} {
      // 🔒 2026-08-17: 부모가 죽은 컬렉션이라 함께 닫는다(문서당 get() 과금도 사라진다).
      allow read: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ========================================================
    // 📚 학습 자료 (learningMaterials)
    // ========================================================
    // ⚠️ 죽은 컬렉션 (2026-08-17 하드닝). 라이브 문서 0건 · src/·functions/ 참조 0건.
    //    `write: if isAdmin()` 은 학급 스코프가 없어 승인 교사 누구나 전역 자료를 쓸 수 있었다.
    match /learningMaterials/{materialId} {
      allow read: if false;
      allow write: if false;
    }

    // ========================================================
    // 🎵 음악 요청 (musicRequests)
    // ========================================================
    match /musicRequests/{requestId} {
      allow read: if isSameClassFast(resource.data.classCode) || isAdminFast();
      allow create: if isSignedIn();
      allow update: if isOwner(resource.data.requesterId) || isAdmin();
      allow delete: if isOwner(resource.data.requesterId) || isAdmin();
    }

    // 🎮 범용 게임 컬렉션(games — 오목·장기·체스)도 2026-08-03 제거.
    //    codex 교차검증 발견: 이 규칙만 `create: if isSignedIn()` 이라 로그인한 학생이
    //    문서를 무제한 생성할 수 있었는데, src/·functions/ 어디에도 이 컬렉션을 쓰는
    //    코드가 없었다(사용처 0). 즉 기능은 없고 쓰기 공격면만 열려 있던 상태다.
    //    자산 민팅 경로는 아니지만 저장·쓰기 비용을 태울 수 있어 함께 닫는다.

    // ========================================================
    // 🎮 게임 컬렉션(chessGames·omokGames·gonuGames)은 2026-08-03 제거
    //    게임 기능 자체를 걷어내면서 규칙도 함께 삭제 — 기본 deny로 떨어진다.
    //    기존 문서는 Firestore에 남아 있으나 읽기·쓰기 모두 차단된다.
    // ========================================================

    // ========================================================
    // 📊 통계 (system_stats)
    // ========================================================
    match /system_stats/{statId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ========================================================
    // 🔴 에러 로그 (errorLogs) - SuperAdmin 전용
    // ========================================================
    match /errorLogs/{logId} {
      // 읽기: SuperAdmin만
      allow read: if isSuperAdminFast();
      // 쓰기: 모든 로그인 사용자 (에러 발생 시 자동 기록) 또는 SuperAdmin
      allow create: if isSignedIn();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ========================================================
    // 🚨 경찰서 (policeReports)
    // ========================================================
    match /policeReports/{reportId} {
      allow read: if isSameClassFast(resource.data.classCode) || isAdminFast();
      allow create: if isAdmin() ||
                       (isSameClass(request.resource.data.classCode) && policeReportCreateValid());
      allow update: if isAdmin() ||
                       (isSameClass(resource.data.classCode) && policeReportIdentityFrozen());
      allow delete: if isAdmin();
    }

    // ========================================================
    // 🏛️ 국회 (legislations)
    // ========================================================
    match /legislations/{legislationId} {
      allow read: if isSameClassFast(resource.data.classCode);
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /legislations/{legislationId}/votes/{voteId} {
      allow read: if isSameClassFast(get(/databases/$(database)/documents/legislations/$(legislationId)).data.classCode);
      // 🔒 create 만 열려 있었다 — read 는 isSameClassFast 로 올바르게 좁혀져 있는데
      //   create 는 로그인만 보고 통과시켜, 타 학급 학생이 남의 학급 법안 표결 문서를
      //   무제한 생성할 수 있었다(학급 검증도 신원 검증도 없음).
      //   실측(2026-08-11): legislations 는 **라이브 문서 0건 · src/functions 참조 0줄** =
      //   미사용 컬렉션이다. 되살릴 때 학급·신원 검증을 넣어 다시 열 것.
      allow create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ========================================================
    // 🎫 주차권 (parkingTickets)
    // ========================================================
    match /parkingTickets/{ticketId} {
      allow read: if isOwner(resource.data.userId) || isAdminFast();
      allow create: if isSignedIn();
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ========================================================
    // 📋 조직도 (organizationChart)
    // ========================================================
    match /organizationChart/{classCode} {
      allow read: if isSameClassFast(classCode);
      allow write: if isClassAdmin(classCode); // 🏫 Phase1: 자기 학급 조직도만
    }

    // ========================================================
    // 💼 직업 (jobs)
    // ========================================================
    match /jobs/{jobId} {
      // 🔒 읽기 학급 스코프 (2026-08-17). 종전 `if isSignedIn()` 은 "클라가 항상
      //   where(classCode == 자기학급) 로만 조회하니까" 를 전제로 열려 있었다 — 클라이언트 쿼리는
      //   보안 통제가 아니다. 필터 없는 getDocs(collection(db,'...')) 한 줄이면 전국 학급 문서가
      //   그대로 나온다. 쓰기는 2026-07-19 하드닝에서 resource.data.classCode 로 이미 잠갔고,
      //   읽기만 같은 필드를 안 보고 있었다(감사 3회가 놓친 이유: 헬퍼 호출 횟수를 셌기 때문).
      //   클라 조회 6곳 전부 where(classCode==자기학급) 사용 실측 → 회귀 0.
      allow read: if isSignedIn() && (isAdminFast() || isSameClassFast(resource.data.classCode));
      // 🏫 Phase1(2026-07-19): jobs는 classCode 필드 보유(전수 실측) → 자기 학급 직업만 관리.
      allow create: if isClassAdmin(request.resource.data.classCode);
      // 🏫 Phase1(codex+Gemini CRITICAL): update 시 classCode 동결 — 자기 학급 문서의 classCode만 바꿔
      //   타 학급 카탈로그로 이동시키는 위조 차단(구매/직업/할일 CF가 이동된 문서를 정상 취급). 이관은 슈퍼관리자도 delete+재생성.
      allow update: if isClassAdmin(resource.data.classCode) &&
                       request.resource.data.classCode == resource.data.classCode;
      allow delete: if isClassAdmin(resource.data.classCode);
    }

    // ========================================================
    // 📝 공통 할일 (commonTasks)
    // ========================================================
    match /commonTasks/{taskId} {
      // 🔒 읽기 학급 스코프 (2026-08-17). 종전 `if isSignedIn()` 은 "클라가 항상
      //   where(classCode == 자기학급) 로만 조회하니까" 를 전제로 열려 있었다 — 클라이언트 쿼리는
      //   보안 통제가 아니다. 필터 없는 getDocs(collection(db,'...')) 한 줄이면 전국 학급 문서가
      //   그대로 나온다. 쓰기는 2026-07-19 하드닝에서 resource.data.classCode 로 이미 잠갔고,
      //   읽기만 같은 필드를 안 보고 있었다(감사 3회가 놓친 이유: 헬퍼 호출 횟수를 셌기 때문).
      //   클라 조회는 Dashboard 1곳뿐이고 where(classCode)+limit(50) 사용 실측 → 회귀 0.
      allow read: if isSignedIn() && (isAdminFast() || isSameClassFast(resource.data.classCode));
      // 🏫 Phase1(2026-07-19): commonTasks는 classCode 필드 보유(REST 실측 확인) → 자기 학급 할일만 관리.
      allow create: if isClassAdmin(request.resource.data.classCode);
      // 🏫 Phase1(codex+Gemini CRITICAL): update 시 classCode 동결 — 자기 학급 문서의 classCode만 바꿔
      //   타 학급 카탈로그로 이동시키는 위조 차단(구매/직업/할일 CF가 이동된 문서를 정상 취급). 이관은 슈퍼관리자도 delete+재생성.
      allow update: if isClassAdmin(resource.data.classCode) &&
                       request.resource.data.classCode == resource.data.classCode;
      allow delete: if isClassAdmin(resource.data.classCode);
    }

    // ========================================================
    // 🎯 과제 (tasks)
    // ========================================================
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ========================================================
    // ⚙️ 전역 설정 (settings)
    // ========================================================
    // 거절된 선생님 이메일 목록 — 슈퍼관리자만 write (학급 관리자 차단)
    match /Settings/rejectedTeachers {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /Settings/{documentId} {
      allow read: if isSignedIn();
      // 🔒 2026-08-17 전역 설정 쓰기 좁히기.
      //   종전 `isAdmin()` 은 **승인된 교사 누구나** 이 컬렉션 전체를 쓸 수 있다는 뜻이었다.
      //   여기 들어 있는 문서는 전부 학급이 아니라 **서비스 전체**를 좌우한다:
      //     · scheduler.vacationMode  — 전국 자동 주급/세금 스케줄러 on/off
      //     · exchangeRate            — 환율(실주식 서비스)
      //     · centralStocksCache      — 전 학급 공용 시세 미러
      //     · rejectedTeachers        — 교사 가입 거부 명단
      //   rules 주석에 남아 있던 "전역 공용이라 학급 스코프 무의미"는 **교사가 수동 승인된
      //   5명일 때만 참**이다. 전국 개방을 하는 순간 이 전제가 깨진다(온보딩 자동화보다 먼저
      //   좁혀야 하는 이유). 실측: 클라이언트가 쓰는 문서는 activeStatus 와 rejectedTeachers
      //   둘뿐이고, 나머지는 전부 Cloud Functions(Admin SDK, rules 우회)가 쓴다.
      //   activeStatus 는 주식 스케줄러 트리거라 학생도 써야 하므로 **필드까지 고정**한다
      //   (AuthContext 의 setDoc merge 는 이 두 필드만 보낸다 — 임의 키 주입 차단).
      //   ⚠️ create 와 update 를 나눈 이유(Gemini 교차검증): `request.resource.data` 는 델타가 아니라
      //      **병합 결과 문서 전체**다. update 에 keys().hasOnly() 를 걸면 이 문서에 레거시 필드가
      //      하나라도 생기는 순간 학생 하트비트가 **조용히** 거부된다(클라가 .catch(()=>{}) 로 삼킨다
      //      → 주식 스케줄러 트리거가 말없이 멎는다). update 는 **바뀐 키**만 본다.
      //   🔒 값 무결성 (codex 교차검증). `hasOnly()` 는 "이 키들만"이지 "이 키들이 있어야 한다"가
      //      아니다 — 그래서 종전 형태로는 학생이 이 문서를 **빈 문서로 덮어쓸 수** 있었다.
      //      그게 왜 문제인가: stockPriceScheduler(scheduler-http.js:237)가 `lastActiveAt` 을 읽어
      //      "최근 70분 내 접속자 없음"이면 시세 갱신을 통째로 건너뛴다. 즉 학생 한 명이
      //      **전국 주식 시세를 멈출 수** 있었다(비용 절감 게이트를 DoS 로 뒤집는 경로).
      //      미래 시각을 박아 스케줄러를 상시 깨우는 반대 방향도 함께 막는다(<= request.time).
      // create 는 문서 전체가 곧 델타라 전체 키를 제한해도 같다.
      allow create: if isSuperAdmin() ||
                       (isValidHeartbeat(documentId) &&
                        request.resource.data.keys().hasOnly(['lastActiveAt', 'lastActiveUserId']));
      // update 는 **바뀐 키**만 제한한다(레거시 필드가 있어도 하트비트가 산다).
      allow update: if isSuperAdmin() ||
                       (isValidHeartbeat(documentId) &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['lastActiveAt', 'lastActiveUserId']));
      allow delete: if isSuperAdmin();
    }

    // settings (소문자) - classCodes(전역)·mainSettings(전역)·salarySettings_{classCode}(학급별) 혼합
    match /settings/{documentId} {
      // 🔒 읽기도 학급 스코프 (2026-08-17 codex 교차검증). 쓰기만 잠그고 읽기를 열어둔
      //   **이번 P0 가 고친 것과 똑같은 버그클래스**가 여기에도 있었다 — 타 학급의
      //   salarySettings_{cc}(세율·급여상한)와 menuLocks_{cc}(그 반이 뭘 숨겼는지)가 다 보였다.
      //   전역 문서 둘은 열어 둔다: mainSettings(화폐단위·쿠폰가치, 전 학급 공용) ·
      //   classCodes(가입 시 학급코드 검증에 필요 — core.js:255).
      allow read: if isSignedIn() && (
                     isAdminFast() ||
                     documentId == 'mainSettings' ||
                     documentId == 'classCodes' ||
                     isOwnClassSettingDocFast(documentId)
                   );
      // 🏫 Phase1(2026-07-19 codex CRITICAL + Gemini v2 재검증): 이 컬렉션은 전역 문서(classCodes·mainSettings)와
      //   학급별 급여설정(salarySettings_{classCode}, 세율·급여상한)이 섞여 있다. 학급별 문서는
      //   documentId 접미사('salarySettings_'+classCode)가 곧 소유 학급이므로, 그 docID를 '자기 학급'과 직접
      //   대조한다(payload의 self-report classCode 필드가 아니라 — 그 값은 docID와 decouple돼 위조 가능:
      //   교사 A가 setDoc(salarySettings_B, {classCode:A})로 B 급여를 왜곡할 수 있었다, Gemini v2 재현).
      //   salarySettings_ 패턴이 아닌 전역 문서(classCodes·mainSettings·접미사없는 salarySettings)는 기존 isAdmin().
      //   슈퍼관리자는 전부 통과. delete는 isAdmin 유지(request.resource=null이라 docID 대조는 create/update만).
      // 🔒 2026-08-17: 종전 3항연산자의 else 분기가 `true` 였다 — 즉 salarySettings_ 접미사가
      //   아닌 **모든 전역 문서**(classCodes·mainSettings·stockExchange·stockExchangeSettings·
      //   무접미 salarySettings)를 승인 교사 누구나 쓸 수 있었다. 실사용을 실측해 셋으로 쪼갠다:
      //     · salarySettings_{classCode} → 자기 학급만 (기존 유지)
      //     · mainSettings               → 교사 OK. 단 실제로 쓰는 두 필드만
      //         (couponValue = Dashboard 쿠폰가치, currencyUnit = AdminSettingsModal 화폐단위).
      //         ⚠️ 이 둘이 학급별이 아니라 **전역**인 것 자체가 설계 부채다 — 한 교사가 바꾸면
      //            모든 학급의 쿠폰가치·화폐단위가 바뀐다. 여기서는 임의 키 주입만 막고,
      //            학급별 분리는 별도 작업으로 남긴다(기능을 바꾸지 않기 위함).
      //     · menuLocks_{classCode}      → 자기 학급만 (교사 메뉴 잠금)
      //         ⚠️ 종전 `: true` 분기에서 이게 **타 학급 것도 쓸 수 있었다** — 교사 A 가 B 반 학생의
      //            메뉴를 임의로 숨길 수 있었다는 뜻이다. 라이브 문서가 0건이라 실측 목록엔 안 잡혔고,
      //            "기능이 안 깨지나" 자체 점검에서 뒤늦게 드러났다(없는 문서는 세어지지 않는다 —
      //            read_leak 때 감사가 헬퍼 호출 횟수를 세다 놓친 것과 같은 함정).
      //     · 그 외 전역 문서(classCodes 등) → 슈퍼관리자만.
      //         classCodes 는 UI 가 이미 isSuperAdmin 게이팅이라(AdminSettingsModal 학급 코드
      //         관리 섹션) 기능 변화 0. 규칙만 UI 를 따라간다.
      //   ⚠️ create/update 분리(Gemini 교차검증): update 의 화이트리스트는 **바뀐 키**에만 건다.
      //      병합 결과 전체에 걸면 mainSettings 에 레거시 필드가 하나라도 있는 순간
      //      교사의 쿠폰가치·화폐단위 저장이 통째로 막힌다(현재 라이브 필드는 couponValue·updatedAt 둘뿐이라
      //      지금은 안 걸리지만, 필드 하나 추가되면 조용히 깨지는 형태다).
      allow create: if isSuperAdmin() ||
                       (isAdmin() &&
                        (isOwnClassSettingDoc(documentId) ||
                         (documentId == 'mainSettings' &&
                          request.resource.data.keys()
                            .hasOnly(['couponValue', 'currencyUnit', 'updatedAt']))));
      allow update: if isSuperAdmin() ||
                       (isAdmin() &&
                        (isOwnClassSettingDoc(documentId) ||
                         (documentId == 'mainSettings' &&
                          request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['couponValue', 'currencyUnit', 'updatedAt']))));
      // delete도 동일 docID 대조(codex v2): 타 학급 salarySettings 삭제(급여설정 DoS) 차단.
      // 🔒 2026-08-17: 여기도 else 분기가 `true` 라 교사가 classCodes·mainSettings 를 **삭제**할
      //   수 있었다(전 학급 로그인 차단 = 전역 DoS). 전역 문서 삭제는 슈퍼관리자만.
      allow delete: if isSuperAdmin() || (isAdmin() && isOwnClassSettingDoc(documentId));
    }

    // ========================================================
    // 💰 세금 설정 (taxSettings)
    // ========================================================
    match /taxSettings/{classCode} {
      // 🔒 읽기 학급 스코프 (2026-08-17). 경로 자체가 학급이라 필드 의존이 없다.
      //   주석의 "주식 거래 시 세율 확인용"은 실제로 성립하지 않는다 — 라이브 문서 0건,
      //   클라이언트 참조 0건(세율은 governmentSettings 에 들어 있다). 읽기 노출만 남아 있었다.
      allow read: if isSameClassFast(classCode) || isAdminFast();
      // 🏫 Phase1(2026-07-19): 세율 설정은 자기 학급만. 기존 isAdmin()은 교사 A가 타 학급 세율을
      //   조작할 수 있었다(경제 그리핑). classCode=경로.
      allow write: if isClassAdmin(classCode);
    }

    // ========================================================
    // 🎯 학급 목표 (goals)
    // ========================================================
    match /goals/{goalId} {
      // 🔒 읽기 학급 스코프 (2026-08-17). **필드가 아니라 문서 ID 로** 스코프하는 이유:
      //   goals 문서 ID 는 전 호출부에서 `${classCode}_goal` 로 파생된다(CouponGoalPage·MyAssets·
      //   Dashboard·RecoverDonations·FirestoreDoctor·CF 전부 동일). 필드 기반으로 잠그면
      //   **아직 목표를 안 만든 신규 학급**이 getDoc 할 때 resource 가 null 이라 규칙이 오류로
      //   떨어져 "문서 없음"이 아니라 permission-denied 가 된다. 문서 ID 대조는 그 함정이 없다.
      //   (라이브 실측: goals 17건 중 3건은 classCode 필드 자체가 없고 오타 ID 도 5건 섞여 있다)
      //   ⚠️ **빈 학급코드 가드** — 이게 없으면 `'' + '_goal'` = `'_goal'` 이 되어, 학급코드가
      //      비어 있는 계정(클레임 미부여·user 문서 부재)이 `goals/_goal` 을 읽을 수 있다.
      //      지금 그 이름의 문서는 없지만, 규칙이 "빈 값이면 아무거나"로 읽히는 형태를 남기지 않는다.
      //      (자체 테스트에서 잡힌 실제 구멍이다 — 문자열 결합 스코프는 늘 빈 값을 먼저 의심할 것)
      allow read: if isSignedIn() && (
                     isAdminFast() ||
                     (request.auth.token.get('classCode', '') is string &&
                      request.auth.token.get('classCode', '').size() > 0 &&
                      goalId == request.auth.token.get('classCode', '') + '_goal') ||
                     (getUserClassCode() is string &&
                      getUserClassCode().size() > 0 &&
                      goalId == getUserClassCode() + '_goal')
                   );

      // 생성: 🔒 자기 학급 목표만 (2026-08-17 Gemini 교차검증).
      //   종전 `if isAdmin()` 은 교사 A 가 `goals/{B학급}_goal` 을 **선점 생성**해
      //   B 학급의 쿠폰 목표를 조작할 수 있었다(읽기는 이미 잠갔는데 쓰기가 열려 있었다 —
      //   이번 P0 가 고친 것과 정확히 반대 방향의 같은 버그클래스).
      //   실사용 확인: MyAssets·FirestoreDoctor·RecoverDonations 전부 `userDoc.classCode` 로
      //   goalId 를 만든다 → 자기 학급만 쓰므로 회귀 0.
      allow create: if isAdmin() && isOwnClassGoal(goalId);

      // 수정: 🔒 관리자만. 학생 분기를 **통째로 없앴다**(2026-08-11).
      //
      //   1차 판단은 "학급 검사만 추가"였다. 종전 규칙(`isSignedIn() && hasOnly([progress,
      //   donations, currentAmount, updatedAt])`)엔 학급 대조가 없어 타 학급 학생이 남의 학급
      //   쿠폰 목표를 조작할 수 있었기 때문이다. 그런데 2차 교차검증에서 더 근본적인 게 나왔다:
      //   **학생은 이 권한이 애초에 필요 없다.**
      //     · 정상 기부는 전부 `donateCoupon` CF(Admin SDK, rules 우회)가 처리한다 —
      //       쿠폰 차감·progress/donations/donationCount 갱신·활동로그가 한 트랜잭션이다.
      //     · 실측: src 전체에서 goals 에 대한 클라이언트 `updateDoc` **0건**
      //       (MyAssets 의 transaction.set 은 문서 부재 시 생성이고 그건 create 규칙이 governs).
      //   즉 이 분기는 기능에 쓰이지 않으면서 **CF 를 우회해 쿠폰 차감 없이 진행률만 올리는
      //   통로**로만 남아 있었다. 필드 화이트리스트는 "무엇을" 만 막고 "대가를 치렀는지"는 못 막는다.
      allow update: if isAdmin() && isOwnClassGoal(goalId);

      // 삭제: 자기 학급 목표만
      allow delete: if isAdmin() && isOwnClassGoal(goalId);
    }

    // ========================================================
    // 🏫 Class 컬렉션 (대문자 - 실제 학급 데이터)
    // SuperAdmin은 모든 학급 조회 가능
    // ========================================================
    match /Class/{classCode} {
      // 읽기: 같은 학급 또는 관리자 (타 학급 학생 명단 노출 방지)
      allow read: if isSameClassFast(classCode) || isAdminFast();
      // 🏫 Phase1(2026-07-19): 자기 학급 교사만 write(isClassAdmin=자기학급 교사 or 슈퍼관리자).
      allow write: if isClassAdmin(classCode);

      // 학생 서브컬렉션
      match /students/{studentId} {
        // 읽기: 같은 학급 또는 관리자
        allow read: if isSameClassFast(classCode) || isAdminFast();
        // 🏫 Phase1: 자기 학급만
        allow write: if isClassAdmin(classCode);
      }
    }

    // ========================================================
    // 🏫 학급 데이터 (classes - 소문자)
    // ========================================================
    match /classes/{classCode} {
      allow read: if isSameClassFast(classCode) || isAdminFast();
      allow write: if isClassAdmin(classCode); // 🏫 Phase1: 자기 학급만

      // 📚 학습 게시판 서브컬렉션 (classes/{classCode}/learningBoards/{boardId})
      match /learningBoards/{boardId} {
        allow read: if isSameClassFast(classCode) || isAdminFast();
        allow create: if isClassAdmin(classCode); // 🏫 Phase1: 자기 학급만
        allow update: if isClassAdmin(classCode);
        allow delete: if isClassAdmin(classCode);

        // 게시글 서브컬렉션 (classes/{classCode}/learningBoards/{boardId}/posts/{postId})
        match /posts/{postId} {
          allow read: if isSameClassFast(classCode) || isAdminFast();
          allow create: if isSignedIn() && isSameClass(classCode);
          allow update: if isSignedIn() && isSameClass(classCode);
          allow delete: if isOwner(resource.data.authorId) || isAdmin();

          // 댓글 서브컬렉션
          match /comments/{commentId} {
            allow read: if isSameClassFast(classCode) || isAdminFast();
            allow create: if isSignedIn() && isSameClass(classCode);
            allow delete: if isOwner(resource.data.authorId) || isAdmin();
          }
        }
      }

      // 🧱 담벼락 (개인 게시판) — classes/{classCode}/personalBoards/{ownerId}
      // 문서 ID = 소유 학생 uid. visibility: 'private'(주인+교사만) | 'class'(같은 반 전체 열람·댓글)
      // 주의: *Fast 헬퍼는 read 전용. 학급공개 판의 글/댓글 읽기·쓰기는 부모 판 문서의
      // visibility를 get()으로 확인(비공개 판은 문서 부재→get 오류→자동 거부, 주인/교사는 그 전에 단락).
      match /personalBoards/{ownerId} {
        allow read: if isOwner(ownerId) || isAdminFast() ||
                       (isSameClassFast(classCode) && resource.data.get('visibility', 'private') == 'class');
        // 생성: 주인 학생 본인(비공개로만) 또는 교사. 학생이 스스로 학급공개로 만들지 못하게 강제.
        allow create: if (isOwner(ownerId) && request.resource.data.get('visibility', 'private') == 'private') || isAdmin();
        // 공개범위 변경 등 수정·삭제: 교사만
        allow update: if isAdmin();
        allow delete: if isAdmin();

        // 글: 주인 학생이 자기 담벼락에 작성(교사도 가능)
        // 쓰기 시 authorId는 본인 uid로 강제, isTeacher는 실제 교사만 true 가능(사칭 차단), 길이 상한.
        match /posts/{postId} {
          allow read: if isOwner(ownerId) || isAdminFast() ||
                         (isSameClassFast(classCode) &&
                          get(/databases/$(database)/documents/classes/$(classCode)/personalBoards/$(ownerId)).data.get('visibility', 'private') == 'class');
          allow create: if (isOwner(ownerId) || isAdmin()) &&
                           request.resource.data.authorId == request.auth.uid &&
                           (request.resource.data.get('isTeacher', false) == false || isAdmin()) &&
                           isValidString(request.resource.data.content, 2000);
          allow update: if isOwner(resource.data.authorId) || isAdmin();
          allow delete: if isOwner(resource.data.authorId) || isAdmin();

          // 댓글: 교사 + 판 주인 학생 + (학급공개면 같은 반 전체)
          match /comments/{commentId} {
            allow read: if isOwner(ownerId) || isAdminFast() ||
                           (isSameClassFast(classCode) &&
                            get(/databases/$(database)/documents/classes/$(classCode)/personalBoards/$(ownerId)).data.get('visibility', 'private') == 'class');
            allow create: if (isAdmin() || isOwner(ownerId) ||
                             (isSameClass(classCode) &&
                              get(/databases/$(database)/documents/classes/$(classCode)/personalBoards/$(ownerId)).data.get('visibility', 'private') == 'class')) &&
                             request.resource.data.authorId == request.auth.uid &&
                             (request.resource.data.get('isTeacher', false) == false || isAdmin()) &&
                             isValidString(request.resource.data.content, 1000);
            allow delete: if isOwner(resource.data.authorId) || isAdmin();
          }
        }
      }

      // 🎵 음악 요청 서브컬렉션 (classes/{classCode}/musicRequests/{requestId})
      match /musicRequests/{requestId} {
        allow read: if isSameClassFast(classCode) || isAdminFast();
        allow create: if isSignedIn() && isSameClass(classCode);
        allow update: if isSignedIn() && isSameClass(classCode);
        allow delete: if isOwner(resource.data.requesterId) || isAdmin();
      }

      // 부동산 서브컬렉션
      match /realEstateProperties/{propertyId} {
        allow read: if isSameClassFast(classCode) || isAdminFast();
        allow write: if isClassAdmin(classCode); // 🏫 Phase1: 자기 학급만
      }

      // 부동산 설정 서브컬렉션
      match /realEstateSettings/{settingsDoc} {
        allow read: if isSameClassFast(classCode) || isAdminFast();
        allow write: if isClassAdmin(classCode); // 🏫 Phase1: 자기 학급만
      }

      // 부동산 가격 제시(흥정) 서브컬렉션 — 쓰기는 Cloud Function(admin SDK)만
      match /realEstateOffers/{offerId} {
        allow read: if isSameClassFast(classCode) || isAdminFast();
        allow write: if false;
      }

      // 🎯 경매 서브컬렉션 (classes/{classCode}/auctions/{auctionId})
      match /auctions/{auctionId} {
        allow read: if isSameClassFast(classCode) || isAdminFast();
        // 🔒 생성: CF(createAuction) 전용 = `if false`. 경매 등록은 아이템 차감과 원자적으로
        //    묶여야 하므로(비원자 시 forge-create→cancel 아이템 복제, codex HIGH) 클라 직접 생성 금지.
        //    createAuction CF가 Admin SDK로 아이템 차감+경매 생성을 단일 트랜잭션 처리(rules 우회).
        allow create: if false;
        // 🔒 갱신: CF(Admin SDK) 전용 = `if false`. 입찰(placeBid)·정산(settleAuction)·취소(cancelAuction)가
        //    모두 CF로 이관됨 → 클라 직접 update 전면 금지. ⚠️ isAdmin()이 아닌 false여야 함(codex):
        //    isAdmin()은 승인 관리자가 클라 SDK로 highestBidder/currentBid를 직접 위조하는 것을 허용 →
        //    fake-escrow 잔존. Admin SDK(CF)는 rules를 우회하므로 false로도 서버 쓰기는 정상 동작.
        allow update: if false;
        // 삭제: cleanup(오래된 완료경매 클라 deleteDoc, 교사)이 의존 → isAdmin() 유지. 관리자 클라의
        //    진행중 경매 직접삭제(에스크로 소각)는 의도적 콘솔오용 잔여(정상 취소=cancelAuction CF가 환불).
        allow delete: if isAdmin();

        // 입찰 서브컬렉션
        match /bids/{bidId} {
          allow read: if isSameClassFast(classCode) || isAdminFast();
          allow create: if isSignedIn() && isSameClass(classCode);
          allow update: if false;
          allow delete: if isAdmin();
        }
      }

      // 🏛️ 국회 법안 서브컬렉션 (classes/{classCode}/nationalAssemblyLaws/{lawId})
      match /nationalAssemblyLaws/{lawId} {
        allow read: if isSameClassFast(classCode) || isAdminFast();
        allow create: if isSignedIn() && (isSameClass(classCode) || isAdmin());
        allow update: if isSignedIn() && (isSameClass(classCode) || isAdmin());
        allow delete: if isAdmin();
      }

      // 🏛️ 국회 설정 서브컬렉션 (classes/{classCode}/nationalAssemblySettings/{document})
      match /nationalAssemblySettings/{document} {
        allow read: if isSameClassFast(classCode) || isAdminFast();
        allow write: if isClassAdmin(classCode); // 🏫 Phase1: 자기 학급만
      }

      // 🗳️ 사용자 투표 기록 서브컬렉션 (classes/{classCode}/userVotes/{userId})
      match /userVotes/{userId} {
        allow read: if isSameClassFast(classCode) || isAdminFast();
        allow create: if isSignedIn() && (isOwner(userId) || isAdmin());
        allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
        allow delete: if isAdmin();
      }

      // 🏦 국고 서브컬렉션 (classes/{classCode}/treasury/{document})
      match /treasury/{document} {
        allow read: if isSameClassFast(classCode) || isAdminFast();
        allow write: if isClassAdmin(classCode); // 🏫 Phase1: 자기 학급만
      }

      // 💰 국고 거래 내역 서브컬렉션 (classes/{classCode}/treasuryTransactions/{transactionId})
      match /treasuryTransactions/{transactionId} {
        allow read: if isSameClassFast(classCode) || isAdminFast();
        allow create: if isClassAdmin(classCode); // 🏫 Phase1: 자기 학급만
        allow update: if false; // 거래 내역은 수정 불가
        allow delete: if isClassAdmin(classCode); // 🏫 Phase1: 자기 학급만
      }

      // 🚨 경찰서 신고 서브컬렉션 (classes/{classCode}/policeReports/{reportId})
      match /policeReports/{reportId} {
        allow read: if isSameClassFast(classCode) || isAdminFast();
        allow create: if isAdmin() ||
                         (isSignedIn() && isSameClass(classCode) && policeReportCreateValid());
        allow update: if isAdmin() ||
                         (isSignedIn() && isSameClass(classCode) && policeReportIdentityFrozen());
        allow delete: if isAdmin();
      }

      // 🚨 경찰서 신고 사유 서브컬렉션 (classes/{classCode}/policeReportReasons/{document})
      match /policeReportReasons/{document} {
        allow read: if isSameClassFast(classCode) || isAdminFast();
        allow write: if isClassAdmin(classCode); // 🏫 Phase1: 자기 학급만
      }

      // ⚖️ 법원 고소장 서브컬렉션 (classes/{classCode}/courtComplaints/{complaintId})
      match /courtComplaints/{complaintId} {
        allow read: if isSameClassFast(classCode) || isAdminFast();
        // 🔒 court-lock Tier-2 방어층(2026-07-18): 고소인은 반드시 본인(request.auth.uid) — 학생이 타인을
        //   고소인으로 위조("B가 C를 고소")하는 것 차단. 클라는 항상 complainantId=self로 생성(Court.js) = 회귀 0.
        //   (admin은 대리 생성 가능하도록 || isAdmin() 유지.)
        allow create: if (isSignedIn() && isSameClass(classCode)
                          && request.resource.data.complainantId == request.auth.uid)
                         || isAdmin();
        // 🔒 2026-07-17 배치6-b: 합의금 결과필드(settlementPaid/Amount/Date/ProcessedBy)는
        //   processCourtSettlement CF(admin SDK, rules 우회)만 기록. 클라 직접 update가 이 필드를
        //   되돌리거나 위조하지 못하게 차단(이중지급 reset 공격 방어). status 등 나머지 재판흐름
        //   필드는 그대로 허용(court-flow 클라 의존 유지).
        // 🔒 court-lock Tier-2: complainantId는 생성 후 불변(클라 편집=reason/desiredResolution/defendantId뿐,
        //   complainantId update 경로 0 — 실측). 잠가서 기존 고소의 고소인을 사후 위조(합의금 수취인 바꿔치기) 차단.
        //   defendantId는 편집 기능(EditComplaintModal) 있어 잠그지 않음.
        allow update: if isSignedIn() && isSameClass(classCode) &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['settlementPaid', 'settlementAmount', 'settlementDate', 'settlementProcessedBy', 'complainantId']);
        allow delete: if isAdmin();
      }

      // ⚖️ 재판방 서브컬렉션 (classes/{classCode}/trialRooms/{roomId})
      match /trialRooms/{roomId} {
        allow read: if isSameClassFast(classCode) || isAdminFast();
        // 🔒 court-lock Tier-2 방어층(2026-07-18): 재판방 생성 시 judgeId는 반드시 본인 — 학생이 남(실제 판사)을
        //   judgeId로 지정한 방을 위조하는 것 차단. 클라는 항상 judgeId=self로 생성(Court.js handleStartTrial) = 회귀 0.
        //   (settlement 실권한은 Tier-1에서 이미 hasJobTitle("판사")로 서버검증 — 이건 방 생성 무결성 방어층.)
        allow create: if (isSignedIn() && isSameClass(classCode)
                          && request.resource.data.judgeId == request.auth.uid)
                         || isAdmin();
        // 합의금 완료 마커(settlementPaid 등)는 processTrialSettlement CF(Admin SDK)만 기록 —
        //   클라가 되돌려(settlementPaid:false) 24h 후 이중지급하던 창 차단(batch6-f, courtComplaints 패턴).
        // 🔒 court-lock Tier-2: judgeId·complainantId·defendantId는 생성 후 불변(클라 update 경로 0 — 실측).
        //   잠가서 기존 재판방의 판사/당사자를 사후 바꿔치기(합의금 수취인·처리자 위조)하는 것 차단.
        // 🔒 caseId 추가(2026-08-20): processTrialSettlement 이 지급 시 `room.caseId` 로 고소장을 찾아
        //   '지급 완료' 마커를 남기게 됐다(이중지급 차단). caseId 가 위조되면 엉뚱한 사건이 지급완료로
        //   찍혀 그 사건의 정당한 정산이 막힌다(현금 이동 자체는 방 문서 기준이라 영향 없음).
        //   caseId 도 생성 후 바뀌는 코드 경로가 0이다 — 위 셋과 같은 근거로 잠근다.
        allow update: if isSignedIn() && isSameClass(classCode)
                         && !request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(['settlementPaid', 'settlementAmount', 'settlementDate', 'settlementProcessedBy', 'judgeId', 'complainantId', 'defendantId', 'caseId']);
        allow delete: if isAdmin();

        // 재판방 메시지 서브컬렉션
        match /messages/{messageId} {
          allow read: if isSameClassFast(classCode) || isAdminFast();
          allow create: if isSignedIn() && isSameClass(classCode);
          allow update: if false;
          allow delete: if isAdmin();
        }

        // 재판방 증거 자료 서브컬렉션
        match /evidence/{evidenceId} {
          allow read: if isSameClassFast(classCode) || isAdminFast();
          allow create: if isSignedIn() && isSameClass(classCode);
          allow update: if false; // 증거는 수정 불가
          allow delete: if isAdmin();
        }

        // 재판방 투표 서브컬렉션
        match /voting/{votingId} {
          allow read: if isSameClassFast(classCode) || isAdminFast();
          allow create: if isSignedIn() && isSameClass(classCode);
          allow update: if isSignedIn() && isSameClass(classCode);
          allow delete: if isAdmin();
        }
      }

      // ⚖️ 재판 결과 서브컬렉션 (classes/{classCode}/trialResults/{resultId})
      match /trialResults/{resultId} {
        allow read: if isSameClassFast(classCode) || isAdminFast();
        allow create: if isSignedIn() && isOwner(request.resource.data.judgeId);
        allow update: if isClassAdmin(classCode); // 🏫 Phase1: 자기 학급만
        allow delete: if isClassAdmin(classCode);
      }

      // 🔥 활동 로그 서브컬렉션 (classes/{classCode}/activityLogs/{logId})
      match /activityLogs/{logId} {
        allow read: if isSameClassFast(classCode) || isAdminFast();
        allow create: if isSignedIn() && isSameClass(classCode);
        allow update: if false;
        allow delete: if isAdmin();
      }

      // 📊 마켓 요약 서브컬렉션 (classes/{classCode}/marketSummary/{document})
      match /marketSummary/{document} {
        allow read: if isSameClassFast(classCode) || isAdminFast();
        allow write: if isClassAdmin(classCode); // 🏫 Phase1: 자기 학급만
      }
    }

    // ========================================================
    // 💳 국세청 (taxRecords)
    // ========================================================
    match /taxRecords/{recordId} {
      allow read: if isOwner(resource.data.userId) || isAdminFast();
      // 본인 userId와 일치하는 세금 기록만 생성 가능 (타인 세금 기록 위조 방지)
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ========================================================
    // 💰 국고 (treasury) - 루트 레벨
    // ========================================================
    // 🔒 죽은 컬렉션(클라 참조 0건, 2026-07-19 실측): 과거 same-class에 전체 문서 write를 열어둔
    //   루트 /treasury. 국고 통계는 nationalTreasuries로 일원화됐다. write 전면 잠금(CF는 Admin SDK로 우회).
    match /treasury/{classCode} {
      allow read: if isSameClassFast(classCode) || isAdminFast();
      allow write: if false;
    }

    // 🔒 nationalTreasuries 중복 match 블록 삭제(2026-07-19): 여기 있던 느슨한 규칙
    //   (allow create/update: isAdmin() || isSameClass — 전체 문서 write)이 상단 엄격 블록을
    //   OR로 무력화하고 있었다. 상단(통계 필드 제한)으로 일원화.

    // ========================================================
    // 💳 거래 기록 (transactions) - 루트 레벨
    // ========================================================
    match /transactions/{transactionId} {
      // 읽기: 본인 거래 또는 관리자
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdminFast());

      // 생성: 🔒 금지. 주석은 "자신의 거래만"이라고 했지만 실제 규칙엔 userId 대조가 없어서
      //   `addDoc(transactions, {userId: 남의UID, amount: 1억, description: "관리자 지급"})` 로
      //   **타인의 거래내역에 허위 항목을 심을 수 있었다.** MyAssets.js 가 이 루트 컬렉션을
      //   where("userId","==",uid) 로 읽어 자산 화면에 병합 표시하므로 그대로 보인다.
      //   현금 잔액 자체는 별도로 봉인돼 있어 안 움직이지만, 감사 기록의 신뢰성이 위조 가능했다.
      //   실측(2026-08-11): src 전체에서 이 컬렉션에 대한 클라이언트 write 는 0건 —
      //   유일한 등장이 위 read 쿼리다. 실제 기록은 전부 CF(Admin SDK, rules 우회)가 쓴다.
      allow create: if false;

      // 🔒 update/delete 도 함께 좁힌다(2026-08-11 2차 검증 HIGH2).
      //   create 만 막고 나머지를 그대로 뒀더니 **학급 경계가 없는 전권**이 남았다 —
      //   `isAdmin()` 은 "승인된 교사면 누구나"라서, C1 교사가 C2 학생의 거래기록
      //   amount·description·userId 를 임의로 고치거나 지울 수 있었다.
      //   이 컬렉션엔 classCode 필드가 없으므로(실측) 소유자 문서로 학급을 판정한다.
      //   "임시: 이름 교체용" 이라던 update 는 그 마이그레이션이 끝난 지 오래다 — 필요하면
      //   CF(Admin SDK)로 하면 되고, 감사 기록을 클라에서 고칠 이유가 없다.
      allow update: if false;

      // 삭제: 자기 학급 학생의 기록만(학생 계정 정리 시 필요)
      allow delete: if isClassAdminOfUser(resource.data.userId);
    }

    // ========================================================
    // 🎵 음악 신청방 (musicRooms)
    // ========================================================
    match /musicRooms/{roomId} {
      // 읽기: 같은 학급 또는 관리자 (학급 격리)
      //   기존 데이터(classCode 없음)도 허용해 하위 호환 유지 — 마이그레이션 후 좁힐 수 있음
      allow read: if isSignedIn() && (
        resource.data.get('classCode', null) == null ||
        isSameClassFast(resource.data.classCode) ||
        isAdminFast()
      );

      // 생성: 관리자(선생님) + 본인 teacherId + classCode 본인 학급 강제
      allow create: if isAdmin() &&
                       isOwner(request.resource.data.teacherId) &&
                       isSameClass(request.resource.data.classCode);

      // 수정: 방 생성자 또는 관리자
      allow update: if isOwner(resource.data.teacherId) || isAdmin();

      // 삭제: 방 생성자 또는 관리자
      allow delete: if isOwner(resource.data.teacherId) || isAdmin();

      // 재생목록 서브컬렉션 (musicRooms/{roomId}/playlist/{songId})
      match /playlist/{songId} {
        // 🔒 학급 스코프 (2026-08-17 Gemini 교차검증 CRITICAL).
        //   종전 `if isSignedIn()` — **타 학급 학생이 남의 학급 신청곡 목록을 그대로 읽었다.**
        //   부모 방(musicRooms)은 이미 학급 스코프인데 **하위 컬렉션만 열려 있었다**
        //   (2026-07-19 하드닝이 top-level 만 훑고 서브컬렉션을 안 본 것과 같은 누락).
        //   비용: 규칙의 `get()` 은 **같은 경로면 요청 안에서 캐시**된다 — 재생목록 N곡을
        //   조회해도 부모 방 읽기는 1회다(auctions/{id}/bids 가 쓰는 것과 동일한 패턴).
        //   실측: 라이브 방 3개 전부 classCode 보유, 재생목록 0곡 → 회귀 0.
        allow read: if isSignedIn() && (
          isAdminFast() ||
          isSameClassFast(get(/databases/$(database)/documents/musicRooms/$(roomId)).data.get('classCode', ''))
        );

        // 생성: 🔒 2026-07-17 배치6-a — 유료 결제·우선신청권은 requestMusicPayment CF(admin SDK,
        //   rules 우회)만 기록. 클라 직접 addDoc은 **무료 방(pricePerSong==0)**의 무료곡만 허용.
        //   - 유료 방(pricePerSong>0)은 클라 create 전면 차단 → 결제 우회(무료곡 등록) 봉인.
        //   - 무료 방도 paidAmount==0(정수0, 문자열"0" 차단) · isPriority 필드 부재(truthy 문자열
        //     "0"로 큐점프하는 우회까지 차단) · requesterId 본인만(타인 사칭 차단).
        //   🔒 2026-08-17: 여기에 **학급 검사가 통째로 없었다.** 로그인한 학생이면 누구나
        //      전국의 무료 음악방에 곡을 무제한 등록할 수 있었다(재생목록 오염·스팸).
        //      이 규칙은 이미 부모 방을 get() 하고 있으므로 학급 대조 추가 비용은 0이다.
        //      쓰기라서 클레임(Fast)이 아니라 문서 기반 isSameClass 를 쓴다.
        allow create: if isSignedIn() &&
                         isSameClass(get(/databases/$(database)/documents/musicRooms/$(roomId)).data.get('classCode', '')) &&
                         get(/databases/$(database)/documents/musicRooms/$(roomId)).data.get('pricePerSong', 0) == 0 &&
                         request.resource.data.get('paidAmount', 0) == 0 &&
                         !('isPriority' in request.resource.data) &&
                         request.resource.data.get('requesterId', request.auth.uid) == request.auth.uid;

        // 수정: 방 생성자 또는 관리자만
        allow update: if isOwner(get(/databases/$(database)/documents/musicRooms/$(roomId)).data.teacherId) || isAdmin();

        // 삭제: 방 생성자 또는 관리자만 (재생 완료 시)
        allow delete: if isOwner(get(/databases/$(database)/documents/musicRooms/$(roomId)).data.teacherId) || isAdmin();
      }
    }

    // ========================================================
    // 🔎 YouTube 검색 공유 캐시 (youtubeSearchCache)
    //    학급 전체가 검색 결과를 공유해 YouTube Data API quota(검색 100units/회)를 절약.
    //    민감정보 없음(공개 영상 메타데이터) → 로그인 사용자면 읽기/기록 허용.
    // ========================================================
    match /youtubeSearchCache/{queryId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ========================================================
    // 🏪 개인 상점 (personalShops)
    // ========================================================
    match /personalShops/{shopId} {
      // 읽기: 같은 학급만. classCode 없는 기존 문서는 하위 호환 허용
      allow read: if isSignedIn() && (
        resource.data.get("classCode", null) == null ||
        isSameClassFast(resource.data.classCode) ||
        isAdminFast()
      );

      // 생성: 본인 상점만
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;

      // 수정: 본인/관리자는 전체, 같은 학급 구매자는 매출 관련 필드만
      // 🔒 isSameClass 추가(2026-07-19): 기존엔 isSignedIn()만이라 타 학급 사용자도 매출통계 조작 가능.
      //    구매/정산은 CF(Admin SDK)가 처리하므로 이 클라 분기는 vestigial하지만 cross-class 차단.
      allow update: if isOwner(resource.data.ownerId) || isAdmin() ||
                       (isSignedIn() &&
                        (resource.data.get('classCode', null) == null ||
                         isSameClass(resource.data.classCode)) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalSales', 'totalTaxPaid', 'updatedAt']));

      // 삭제: 본인 또는 관리자
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    // ========================================================
    // 📦 상점 상품 (shopProducts)
    // ========================================================
    match /shopProducts/{productId} {
      // 읽기: 같은 학급만. classCode 없는 기존 문서는 하위 호환 허용
      allow read: if isSignedIn() && (
        resource.data.get("classCode", null) == null ||
        isSameClassFast(resource.data.classCode) ||
        isAdminFast()
      );

      // 생성: 상점 소유자
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;

      // 수정: 상품 소유자/관리자는 전체 수정, 구매자는 재고/판매 관련 필드만
      // status는 'soldout'으로만 변경 가능 (재고 0 시 자동 마킹) — 사보타주 방지
      // 🔒 [보안] 구매자 분기에 같은-학급 조건 추가: 개인상점은 학급 내 거래이므로
      //    정당 구매자는 항상 같은 학급. 타 학급 사용자의 재고/구매자목록 무단 조작 차단.
      allow update: if isOwner(resource.data.ownerId) || isAdmin() ||
                       (isSignedIn() &&
                        (resource.data.get('classCode', null) == null ||
                         isSameClassFast(resource.data.classCode)) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'soldCount', 'buyers', 'status', 'updatedAt']) &&
                        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
                         request.resource.data.status == 'soldout'));

      // 삭제: 상품 소유자 또는 관리자
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    // ========================================================
    // 📜 활동 기록 (activities)
    // ========================================================
    match /activities/{activityId} {
      // 읽기: 거래 당사자(구매자/판매자) 본인 또는 관리자만 (이름 등 개인정보 보호)
      allow read: if isOwner(resource.data.buyerId) || isOwner(resource.data.sellerId) || isAdminFast();

      // 생성: 로그인한 사용자
      allow create: if isSignedIn();

      // 수정: 불가
      allow update: if false;

      // 삭제: 관리자만
      allow delete: if isAdmin();
    }

    // ========================================================
    // 💰 국세청 (nationalTax)
    // ========================================================
    // 🔒 죽은 컬렉션(클라 컬렉션 참조 0건 — 사이드바 nav id 문자열뿐, 2026-07-19 실측):
    //   과거 update가 isSignedIn()만 요구해 학급/소유 무관 로그인 사용자 누구나 payments/totalPaid write 가능했다.
    //   국세청 통계는 nationalTreasuries로 일원화됨. write 전면 잠금(CF는 Admin SDK로 우회).
    match /nationalTax/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ========================================================
    // ⚡ 경제 이벤트 - 활성 이벤트 팝업 (activeEconomicEvent)
    // 클라우드 함수가 쓰기, 같은 학급 사용자가 읽기 (팝업 표시용)
    // ========================================================
    match /activeEconomicEvent/{classCode} {
      allow read: if isSameClassFast(classCode) || isAdminFast();
      allow write: if isClassAdmin(classCode); // 🏫 Phase1: 자기 학급 경제이벤트만
    }

    // ========================================================
    // ⚡ 경제 이벤트 설정 (economicEventSettings)
    // ========================================================
    match /economicEventSettings/{classCode} {
      allow read: if isSameClassFast(classCode) || isAdminFast();
      allow write: if isClassAdmin(classCode); // 🏫 Phase1: 자기 학급 경제이벤트 설정만
    }

    // ========================================================
    // 📋 경제 이벤트 로그 (economicEventLogs)
    // ========================================================
    match /economicEventLogs/{classCode} {
      allow read: if isSameClassFast(classCode) || isAdminFast();
      allow write: if isClassAdmin(classCode); // 🏫 Phase1: 자기 학급 경제이벤트 로그만

      match /entries/{entryId} {
        allow read: if isSameClassFast(classCode) || isAdminFast();
        allow write: if isClassAdmin(classCode); // 🏫 Phase1: classCode=상위 경로 바인딩
      }
    }

    // ========================================================
    // ✅ 보너스 할일 승인 요청 (pendingApprovals)
    // ========================================================
    match /pendingApprovals/{approvalId} {
      allow read: if isSignedIn() && (isSameClassFast(resource.data.classCode) || isAdminFast());
      // 🔒 create는 CF 전용(if false) — 과거 create:if isSignedIn()은 userId/classCode만 검증하고
      //   studentId/cardType/rewardAmount/status는 무검증이라, 학생이 rewardAmount 무제한 위조 문서를
      //   직접 create → 교사 승인 시 processTaskApproval이 cash/coupon 무제한 지급(mint). 정상 경로는
      //   submitTaskApproval CF(보상 금액을 서버가 가중랜덤 추첨=generateTaskReward, 클라 미신뢰,
      //   admin SDK로 생성=if false 우회). processTaskApproval도 테이블 최대(cash 500000·coupon 20) 재검증.
      allow create: if false;
      // 🏫 Phase1(2026-07-19): 승인(status 변경)은 '자기 학급 교사'만. 기존 isAdmin()은 교사 A가 타 학급
      //   pendingApproval을 승인해(트리거/후속 CF가 그 학급 학생에게 보상 지급) 정합성을 흔들 수 있었다.
      //   classCode=문서 필드(read도 resource.data.classCode 사용). 슈퍼관리자는 isClassAdmin 내 전 학급.
      // classCode 동결(codex): 승인 문서를 타 학급으로 옮기는 위조 차단.
      allow update: if isClassAdmin(resource.data.classCode) &&
                       request.resource.data.classCode == resource.data.classCode;
      allow delete: if isClassAdmin(resource.data.classCode);
    }

    // ========================================================
    // 🧑‍🏫 직업 신청 (jobApplications) — 학생이 신청, 교사가 허가
    // ========================================================
    //   직업 개수가 주급을 정하므로(세전 = 200만 + (직업수−1)×50만) 직업이 붙는 경로는
    //   곧 돈이 늘어나는 경로다. pendingApprovals 와 **같은 규약**을 그대로 쓴다.
    //   ⚠️ pendingApprovals 에 섞지 않고 컬렉션을 나눈 이유: 그쪽 문서는 processTaskApproval 로
    //   흘러들어가 현금·쿠폰을 지급한다. 직업 문서가 보상 지급 코드에 닿을 가능성을 구조적으로 없앤다.
    match /jobApplications/{applicationId} {
      allow read: if isSignedIn() && (isSameClassFast(resource.data.classCode) || isAdminFast());
      // 🔒 create는 CF 전용 — 클라가 직접 만들면 studentId/jobId/status 를 무검증으로 심을 수 있고,
      //   교사가 승인하는 순간 processJobApplication 이 그 직업을 붙인다(상한·지정전용 우회).
      //   정상 경로는 saveSelectedJobs CF(admin SDK 라 이 규칙을 우회).
      allow create: if false;
      // 승인/거절은 '자기 학급 교사'만. classCode 동결 — 신청서를 타 학급으로 옮기는 위조 차단.
      //   ⚠️ status 를 클라가 바꿔도 직업이 붙지는 않는다(붙이는 건 CF 의 트랜잭션뿐).
      //   그래도 잠근다: 열어두면 교사 화면의 대기 목록을 남이 비워버릴 수 있다.
      allow update: if isClassAdmin(resource.data.classCode) &&
                       request.resource.data.classCode == resource.data.classCode;
      allow delete: if isClassAdmin(resource.data.classCode);
    }

    // ========================================================
    // 📜 법안 (laws) - 국회/조직도에서 사용
    // ========================================================
    match /laws/{lawId} {
      allow read: if isSignedIn() && (isSameClassFast(resource.data.classCode) || isAdminFast());
      // 본인 학급 법안만 생성 가능
      // 🔒 2026-08-17: create 의 `|| isAdmin()` 은 교사가 **아무 학급 이름표로** 법안을 만들 수
      //   있게 했다. 자기 학급 생성은 첫 분기가 이미 통과시키므로 예외는 슈퍼관리자만 남긴다.
      //   🔒 빈 학급코드 가드(codex): user 문서가 없으면 getUserClassCode() 가 `''` 를 돌려주므로
      //      `classCode: ''` 짜리 법안을 인증 계정 누구나 무제한 만들 수 있었다(무스코프 스팸).
      allow create: if isSignedIn() && (
                       isSuperAdmin() ||
                       (userDocExists() &&
                        getUserClassCode() is string &&
                        getUserClassCode().size() > 0 &&
                        request.resource.data.classCode == getUserClassCode())
                     );
      // 🔒 2026-08-17: update/delete 가 학급을 전혀 안 봤다 — 승인 교사 누구나 타 학급 법안을
      //   승인·거부·삭제할 수 있었고, 이건 죽은 경로가 아니라 OrganizationChart 의 라이브 경로다.
      //   classCode 동결도 함께 건다(자기 학급 법안을 타 학급으로 옮기는 위조 차단 —
      //   jobs·storeItems 와 같은 패턴). 필드 없는 잔재 문서는 get() 기본값으로 슈퍼관리자만 통과.
      allow update: if isClassAdmin(resource.data.get('classCode', '')) &&
                       request.resource.data.get('classCode', '') == resource.data.get('classCode', '');
      allow delete: if isClassAdmin(resource.data.get('classCode', ''));
    }

    // ========================================================
    // 🛍️ 마켓 리스팅 (marketListings) - CF가 작성, 클라이언트 읽기
    // ========================================================
    match /marketListings/{listingId} {
      // 🔒 읽기 학급 스코프 (2026-08-17). 종전 `if isSignedIn()` 은 "클라가 항상
      //   where(classCode == 자기학급) 로만 조회하니까" 를 전제로 열려 있었다 — 클라이언트 쿼리는
      //   보안 통제가 아니다. 필터 없는 getDocs(collection(db,'...')) 한 줄이면 전국 학급 문서가
      //   그대로 나온다. 쓰기는 2026-07-19 하드닝에서 resource.data.classCode 로 이미 잠갔고,
      //   읽기만 같은 필드를 안 보고 있었다(감사 3회가 놓친 이유: 헬퍼 호출 횟수를 셌기 때문).
      //   클라 직접 조회 0건(ItemContext 가 getItemContextData CF 응답으로 받는다) → 회귀 0.
      allow read: if isSignedIn() && (isAdminFast() || isSameClassFast(resource.data.classCode));
      // 🔒 write는 CF 전용(if false) — 클라 marketListings write 0건 확인(전수 grep).
      //   과거 create:if isSignedIn() + update:isOwner(sellerId)는 가짜/조작 리스팅 위조 →
      //   cancelMarketSale이 위조 quantity를 신뢰해 인벤토리 increment 복원 = 아이템-mint 벡터
      //   (2026-07-18 codex 발견). listUserItemForSale/buyMarketItem/cancelMarketSale/respondToOffer
      //   CF가 admin SDK로 write(if false 우회). 위 주석 "CF가 작성, 클라이언트 읽기" 의도와 일치.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ========================================================
    // 💬 마켓 오퍼 (marketOffers) - CF가 작성, 클라이언트 읽기
    // ========================================================
    match /marketOffers/{offerId} {
      // 🔒 읽기 학급 스코프 (2026-08-17). 종전 `if isSignedIn()` 은 "클라가 항상
      //   where(classCode == 자기학급) 로만 조회하니까" 를 전제로 열려 있었다 — 클라이언트 쿼리는
      //   보안 통제가 아니다. 필터 없는 getDocs(collection(db,'...')) 한 줄이면 전국 학급 문서가
      //   그대로 나온다. 쓰기는 2026-07-19 하드닝에서 resource.data.classCode 로 이미 잠갔고,
      //   읽기만 같은 필드를 안 보고 있었다(감사 3회가 놓친 이유: 헬퍼 호출 횟수를 셌기 때문).
      //   클라 직접 조회 0건(ItemContext 가 getItemContextData CF 응답으로 받는다) → 회귀 0.
      allow read: if isSignedIn() && (isAdminFast() || isSameClassFast(resource.data.classCode));
      // 🔒 write는 CF 전용(if false) — 클라 marketOffers write 0건 확인(전수 grep).
      //   과거 update:isOwner(buyerId)는 본인 offer의 offerPrice를 makeOffer의 create검증(offerPrice>0)
      //   이후 음수로 조작 → respondToOffer가 totalPrice=음수 신뢰(buyerCash<음수=false 통과) →
      //   buyer +현금·seller −현금 = 현금-mint 벡터(2026-07-18 Gemini 발견). makeOffer/respondToOffer/
      //   buyMarketItem CF가 admin SDK로 write(if false 우회). 위 주석 "CF가 작성, 클라이언트 읽기" 의도와 일치.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ========================================================
    // ⚙️ 학급 설정 (classSettings) - CF가 읽기/쓰기
    // ========================================================
    match /classSettings/{classCode} {
      allow read: if isSameClassFast(classCode) || isAdminFast();
      allow write: if isClassAdmin(classCode); // 🏫 Phase1: 자기 학급만

      // 급여 등 세부 설정 서브컬렉션 (classSettings/{classCode}/settings/{settingId})
      match /settings/{settingId} {
        allow read: if isSameClassFast(classCode) || isAdminFast();
        allow write: if isClassAdmin(classCode); // 🏫 Phase1: classCode=상위 경로 바인딩
      }
    }

    // ========================================================
    // 🤝 함께구매 (groupPurchases)
    // ========================================================
    match /groupPurchases/{purchaseId} {
      allow read: if isSignedIn() && isSameClassFast(resource.data.classCode);
      // 🔒 생성: 본인 initiator·본인 학급 + 진행 필드를 비워야 함. contributors/currentAmount를 위조해
      //    deleteGroupPurchase 환불(무담보 민팅)·completeGroupPurchase 무료지급하던 벡터 차단 —
      //    이 값들은 joinGroupPurchase CF(실제 cash 차감)를 통해서만 채워질 수 있게 강제.
      allow create: if isSignedIn() &&
                       request.resource.data.initiatorId == request.auth.uid &&
                       request.resource.data.classCode == getUserClassCode() &&
                       request.resource.data.currentAmount == 0 &&
                       request.resource.data.contributors.size() == 0 &&
                       request.resource.data.status == 'active' &&
                       request.resource.data.winnerId == null;
      // 🔒 갱신·삭제: CF(Admin SDK) 전용. 참여(joinGroupPurchase)·완료(completeGroupPurchase)·
      //    삭제/환불(deleteGroupPurchase)이 모두 CF로 이관됨 → 클라 직접 write 금지(위조 봉인).
      allow update: if false;
      allow delete: if false;
    }

    // ========================================================
    // 🔒 Rate Limit 컬렉션 (_rateLimits) - CF 내부 전용, 클라이언트 접근 차단
    // ========================================================
    match /_rateLimits/{docId} {
      allow read, write: if false; // Cloud Functions Admin SDK만 접근
    }

    // ========================================================
    // 🔒 스케줄러 락 (schedulerLocks) - CF 내부 전용
    // ========================================================
    match /schedulerLocks/{docId} {
      allow read, write: if false; // Cloud Functions Admin SDK만 접근
    }

    // ========================================================
    // 🚫 기타 모든 컬렉션은 기본적으로 차단
    // ========================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
